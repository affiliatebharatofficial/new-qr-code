# Application Environment
ENVIRONMENT=development
APP_URL=http://localhost:4321

# Authentication (Server-only secret)
JWT_SECRET=dev-jwt-secret-min-32-chars-long-example-key!

# Cloudflare D1 & R2
# (In production Cloudflare Pages/Workers, bindings are configured via wrangler.toml)
R2_BUCKET_NAME=qr-assets

# Lemon Squeezy Monetization & Billing (Server-only)
LEMONSQUEEZY_API_KEY=ls_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxx
LEMONSQUEEZY_STORE_ID=123456
LEMONSQUEEZY_PRO_PRODUCT_ID=prod_pro_123
LEMONSQUEEZY_PRO_VARIANT_ID=var_pro_123
LEMONSQUEEZY_BUSINESS_PRODUCT_ID=prod_biz_123
LEMONSQUEEZY_BUSINESS_VARIANT_ID=var_biz_123
LEMONSQUEEZY_WEBHOOK_SECRET=dev-webhook-secret-key-123
