---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { extractLocaleFromPath, DEFAULT_LOCALE, type Locale } from '../lib/i18n/config';
import { getHreflangTags } from '../lib/i18n/routes';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noIndex?: boolean;
  locale?: Locale;
}

const {
  title,
  description = 'Free, instant QR Code Generator with custom colors, logos, and frames. Create URL, Wi-Fi, vCard, Email, UPI and Social QR codes without signing up.',
  canonical,
  ogImage = '/og-image.svg',
  jsonLd,
  noIndex = false,
  locale: explicitLocale,
} = Astro.props;

const currentPath = Astro.url.pathname;
const { locale: detectedLocale, cleanPath } = extractLocaleFromPath(currentPath);
const currentLocale = explicitLocale || detectedLocale || DEFAULT_LOCALE;

const siteName = 'QR Code Generator';
const siteUrl = 'https://qrcode.page';
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Self-referencing clean canonical URL
const rawPath = currentPath.replace(/\/+$/, '') || '';
const cleanCanonical = canonical || `${siteUrl}${rawPath ? `${rawPath}/` : '/'}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Dynamic hreflang alternates for all supported locales + x-default
const hreflangTags = getHreflangTags(currentPath);

// Base Schema.org Structured Data with inLanguage
const baseJsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: siteName,
  url: siteUrl,
  inLanguage: currentLocale,
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const finalJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [baseJsonLd, ...jsonLd]
    : [baseJsonLd, jsonLd]
  : baseJsonLd;
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />

    {/* Hreflang Alternates */}
    {hreflangTags.map((tag) => (
      <link rel="alternate" hreflang={tag.lang} href={tag.href} />
    ))}

    {noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={currentLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={cleanCanonical} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Optimized Non-Blocking Fonts Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

    <!-- Theme Initialization Script (Avoids Flash of Light/Dark Mode) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-indigo-500 selection:text-white transition-colors duration-200">
    <Navbar locale={currentLocale} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer locale={currentLocale} />
  </body>
</html>
