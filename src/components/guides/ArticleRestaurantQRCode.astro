---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, DEFAULT_LOCALE } from '../../lib/i18n/config';
import { getRestaurantQRCodeData } from '../../lib/i18n/content/guides/restaurantQRCode';

interface Props {
  locale?: Locale;
  canonicalUrl?: string;
}

const { locale = DEFAULT_LOCALE, canonicalUrl } = Astro.props;
const data = getRestaurantQRCodeData(locale);

const effectiveCanonical = canonicalUrl || (locale === DEFAULT_LOCALE 
  ? 'https://freeqrcode-generator.com/guides/how-to-use-qr-codes-for-restaurants'
  : `https://freeqrcode-generator.com/${locale}/guides/how-to-use-qr-codes-for-restaurants`);

const breadcrumbHome = locale === DEFAULT_LOCALE ? '/' : `/${locale}`;
const breadcrumbGuides = locale === DEFAULT_LOCALE ? '/guides' : `/${locale}/guides`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://freeqrcode-generator.com${breadcrumbHome}` },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `https://freeqrcode-generator.com${breadcrumbGuides}` },
    { '@type': 'ListItem', position: 3, name: data.h1, item: effectiveCanonical },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.h1,
  description: data.description,
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    name: 'Free QR Code Generator',
    url: 'https://freeqrcode-generator.com',
  },
  datePublished: '2026-08-25',
  dateModified: '2026-09-08',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: data.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  locale={locale}
  canonical={effectiveCanonical}
  jsonLd={[breadcrumbJsonLd, articleJsonLd, faqJsonLd]}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400" aria-label="Breadcrumb">
      <a href={breadcrumbHome} class="hover:text-indigo-600 transition-colors">Home</a>
      <span>/</span>
      <a href={breadcrumbGuides} class="hover:text-indigo-600 transition-colors">Guides</a>
      <span>/</span>
      <span class="text-slate-600 dark:text-slate-300 truncate">{data.badge}</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
        <span>🍽️</span> {data.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        {data.h1}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-3xl">
        {data.subheadline}
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 font-mono pt-2">
        <span>{data.updatedDate}</span>
        <span>•</span>
        <span>{data.readingTime}</span>
      </div>
    </header>

    <!-- Quick Takeaways Callout -->
    <div class="p-6 rounded-3xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-200/80 dark:border-indigo-800/80 space-y-3">
      <div class="flex items-center gap-2 text-indigo-700 dark:text-indigo-300 font-bold text-sm uppercase tracking-wider">
        <span>⚡</span> {data.quickTakeawaysTitle}
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
        {data.quickTakeaways.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-indigo-600 font-bold">✓</span>
            <span><strong>{item.label}:</strong> {item.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Table of Contents -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 text-xs sm:text-sm">
      <h3 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">{data.tocTitle}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-indigo-600 dark:text-indigo-400">
        {data.sections.map((sec) => (
          <a href={`#${sec.id}`} class="hover:underline">{sec.heading}</a>
        ))}
      </div>
    </div>

    <!-- Content Sections -->
    <div class="space-y-10 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
      {data.sections.map((sec) => (
        <section id={sec.id} class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
            {sec.heading}
          </h2>
          {sec.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {sec.bullets && (
            <ul class="list-disc pl-6 space-y-2 text-xs sm:text-sm">
              {sec.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <!-- FAQs -->
      <section id="faqs" class="space-y-6 pt-4 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          {data.faqsTitle}
        </h2>
        <div class="space-y-4">
          {data.faqs.map((item) => (
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
              <h3 class="font-bold text-slate-900 dark:text-white text-base">{item.question}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Box -->
      <div class="p-8 rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-800 text-white text-center space-y-4 shadow-xl shadow-indigo-600/20">
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          {data.ctaTitle}
        </h3>
        <p class="text-xs sm:text-sm text-indigo-100 max-w-xl mx-auto leading-relaxed">
          {data.ctaDesc}
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <a
            href={data.ctaButtonLink}
            class="px-6 py-3 rounded-2xl font-bold text-xs sm:text-sm bg-white text-indigo-600 hover:bg-slate-100 transition-all shadow-md"
          >
            {data.ctaButtonText} &rarr;
          </a>
          {data.ctaSecondaryText && (
            <a
              href={data.ctaSecondaryLink || '/'}
              class="px-6 py-3 rounded-2xl font-bold text-xs sm:text-sm bg-indigo-700/80 hover:bg-indigo-700 text-white border border-indigo-500/50 transition-all"
            >
              {data.ctaSecondaryText} &rarr;
            </a>
          )}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
