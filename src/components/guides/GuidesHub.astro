---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale, DEFAULT_LOCALE } from '../../lib/i18n/config';
import { getGuideHubData } from '../../lib/i18n/content/guides/hub';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const data = getGuideHubData(locale);

const canonical = locale === DEFAULT_LOCALE 
  ? 'https://freeqrcode-generator.com/guides' 
  : `https://freeqrcode-generator.com/${locale}/guides`;

const breadcrumbHome = locale === DEFAULT_LOCALE ? '/' : `/${locale}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://freeqrcode-generator.com${breadcrumbHome}` },
    { '@type': 'ListItem', position: 2, name: data.h1, item: canonical },
  ],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  locale={locale}
  canonical={canonical}
  jsonLd={breadcrumbJsonLd}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
        {data.badge}
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {data.h1}
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {data.subheadline}
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.guides.map((g) => {
        const guideLink = locale === DEFAULT_LOCALE 
          ? `/guides/${g.slug}` 
          : `/${locale}/guides/${g.slug}`;
        return (
          <a
            href={guideLink}
            class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-4 group"
          >
            <div class="space-y-3">
              <div class="text-3xl">{g.icon}</div>
              <h2 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 transition-colors leading-snug">
                {g.title}
              </h2>
              <p class="text-xs text-slate-500 leading-relaxed">
                {g.desc}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold text-slate-400">
              <span>{g.readTime}</span>
              <span class="text-indigo-600 group-hover:translate-x-1 transition-transform">Read &rarr;</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
