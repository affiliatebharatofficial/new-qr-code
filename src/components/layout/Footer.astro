---
import { QR_TYPE_METADATA } from '../../lib/qr/types';
import { getUITranslations } from '../../lib/i18n/ui';
import { getLocalizedPath } from '../../lib/i18n/routes';
import type { Locale } from '../../lib/i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = getUITranslations(locale);
const qrTypes = Object.values(QR_TYPE_METADATA);
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 transition-colors mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-1 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="5" height="5" x="3" y="3" rx="1"/>
              <rect width="5" height="5" x="16" y="3" rx="1"/>
              <rect width="5" height="5" x="3" y="16" rx="1"/>
              <path d="M21 16h-3a2 2 0 0 0-2 2v3"/>
              <path d="M21 21v.01"/>
              <path d="M12 7v3a2 2 0 0 1-2 2H7"/>
              <path d="M3 12h.01"/>
            </svg>
          </div>
          <span class="text-base font-bold text-slate-900 dark:text-white">{ui.brand.title}</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          {ui.footer.description}
        </p>
        <div class="flex flex-col gap-1.5 pt-1 text-[11px] text-slate-500">
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold">✓ {ui.footer.clientEngine}</span>
          <span class="text-indigo-600 dark:text-indigo-400 font-semibold">⚡ {ui.footer.edgeRedirects}</span>
        </div>
      </div>

      <!-- Column 1: QR Generators -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
          {ui.footer.generatorsHeader}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath('/url-to-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              URL to QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/wifi-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Wi-Fi QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/vcard-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              vCard QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/venmo-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Venmo QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/paypal-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              PayPal QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/cash-app-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Cash App QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/zelle-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Zelle QR Code
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/upi-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              UPI Payment QR
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Use Cases & Landing Pages -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
          {ui.footer.useCasesHeader}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getLocalizedPath('/digital-business-card', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.nav.businessCards}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/restaurant-menu-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.nav.menus}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/app-download-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              App Store Download
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/google-reviews-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Google Reviews QR
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/event-qr-code-generator', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Event Calendar QR
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/product-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Product Packaging QR
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/social-media-qr-code', locale)} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Social Media QR
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Guides & Resources -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
          {ui.footer.guidesHeader}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/guides" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-semibold">
              All Guides Hub &rarr;
            </a>
          </li>
          <li>
            <a href="/guides/what-is-a-qr-code" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              What is a QR Code?
            </a>
          </li>
          <li>
            <a href="/guides/static-vs-dynamic-qr" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Static vs Dynamic QR
            </a>
          </li>
          <li>
            <a href="/guides/how-to-create-a-wifi-qr-code" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              How to Create Wi-Fi QR
            </a>
          </li>
          <li>
            <a href="/guides/how-to-create-a-vcard-qr-code" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              How to Create vCard QR
            </a>
          </li>
          <li>
            <a href="/guides/how-to-use-qr-codes-for-restaurants" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Restaurant Menus Guide
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Platform & Legal -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
          {ui.footer.platformHeader}
        </h3>
          <li>
            <a href="/about" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-semibold">
              About Us
            </a>
          </li>
          <li>
            <a href="/pricing" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.nav.pricing}
            </a>
          </li>
          <li>
            <a href="/dashboard" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.nav.dashboard}
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.common.privacy}
            </a>
          </li>
          <li>
            <a href="/terms" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.common.terms}
            </a>
          </li>
          <li>
            <a href="/disclaimer" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.common.disclaimer}
            </a>
          </li>
          <li>
            <a href="/contact" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              {ui.common.contact}
            </a>
          </li>
          <li class="pt-1">
            <a href="mailto:support@freeqrcode-generator.com" class="text-indigo-600 dark:text-indigo-400 hover:underline font-bold text-[11px] flex items-center gap-1">
              <span>✉️</span> support@freeqrcode-generator.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 mt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-4">
      <p>&copy; {currentYear} {ui.brand.title}. {ui.footer.allRightsReserved} • <span class="font-bold text-slate-700 dark:text-slate-300">Powered by FK DIGITAL MEDIA</span></p>
      <div class="flex items-center gap-6">
        <span>{ui.footer.noAppNeeded}</span>
        <span>•</span>
        <span>{ui.footer.runsLocally}</span>
      </div>
    </div>
  </div>
</footer>
