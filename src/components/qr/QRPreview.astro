---
import QRWarnings from './QRWarnings.astro';
---

<div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-card space-y-4 text-center">
  <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2.5">
    <div class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">Live Preview</span>
    </div>
    <span id="resolution-badge" class="text-[10px] font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500">
      512 × 512 px
    </span>
  </div>

  <!-- QR Canvas Container -->
  <div class="relative flex items-center justify-center p-4 bg-slate-50 dark:bg-slate-950/70 rounded-lg border border-slate-200/60 dark:border-slate-800/80 min-h-[280px] max-w-full overflow-hidden">
    <!-- Empty State -->
    <div id="qr-empty-state" class="hidden flex-col items-center justify-center text-center p-6 space-y-2">
      <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-slate-800 text-slate-400 flex items-center justify-center mb-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <p class="text-xs font-medium text-slate-500">Enter payload to generate preview.</p>
    </div>

    <!-- Active Viewport -->
    <div id="qr-code-viewport" class="transition-transform duration-150 flex items-center justify-center max-w-full max-h-[280px] overflow-hidden" aria-label="Generated QR Code Preview">
      <!-- Canvas rendered here -->
    </div>
  </div>

  <!-- Real-Time Scannability Warnings -->
  <QRWarnings />

  <slot />
</div>
