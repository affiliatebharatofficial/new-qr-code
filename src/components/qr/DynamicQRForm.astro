<script>
  // Password Visibility Toggle for Wi-Fi Form
  const togglePassBtn = document.getElementById('toggle-wifi-pass');
  const wifiPassInput = document.getElementById('input-wifi-pass') as HTMLInputElement;

  togglePassBtn?.addEventListener('click', () => {
    if (wifiPassInput) {
      if (wifiPassInput.type === 'password') {
        wifiPassInput.type = 'text';
      } else {
        wifiPassInput.type = 'password';
      }
    }
  });

  // Hide/Show password based on Open network mode
  const wifiAuthSelect = document.getElementById('input-wifi-auth') as HTMLSelectElement;
  const wifiPassContainer = document.getElementById('wifi-pass-container');

  wifiAuthSelect?.addEventListener('change', () => {
    if (wifiPassContainer) {
      if (wifiAuthSelect.value === 'nopass') {
        wifiPassContainer.classList.add('hidden');
      } else {
        wifiPassContainer.classList.remove('hidden');
      }
    }
  });
</script>
