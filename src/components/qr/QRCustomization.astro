---
---

<div class="bg-white dark:bg-slate-900 rounded-xl p-4 sm:p-5 border border-slate-200 dark:border-slate-800 shadow-card space-y-4" aria-label="QR Code Customization">
  <div class="flex items-center justify-between pb-2.5 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-900 dark:bg-white"></span>
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
        3. Visual Style &amp; Customization
      </h2>
    </div>
    <span class="text-[10px] font-mono text-slate-400">Client-Side Engine</span>
  </div>

  <!-- PROGRESSIVE DISCLOSURE TABS -->
  <div class="flex border-b border-slate-100 dark:border-slate-800 gap-2 text-xs font-semibold overflow-x-auto pb-1" id="custom-tabs" role="tablist" aria-label="Styling Options">
    <button type="button" class="custom-tab-btn px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold cursor-pointer transition-colors" data-tab="presets" role="tab" aria-selected="true">Presets</button>
    <button type="button" class="custom-tab-btn px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer transition-colors" data-tab="colors" role="tab" aria-selected="false">Colors</button>
    <button type="button" class="custom-tab-btn px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer transition-colors" data-tab="shapes" role="tab" aria-selected="false">Shapes &amp; Eyes</button>
    <button type="button" class="custom-tab-btn px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer transition-colors" data-tab="logo" role="tab" aria-selected="false">Logo</button>
    <button type="button" class="custom-tab-btn px-3 py-1.5 rounded-md text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer transition-colors" data-tab="settings" role="tab" aria-selected="false">Size &amp; Margin</button>
  </div>

  <!-- Tab 1: Presets -->
  <div id="tab-content-presets" class="custom-tab-pane space-y-2.5" role="tabpanel">
    <p class="text-[11px] text-slate-500">Pick a pre-configured theme or fine-tune individual colors and shapes.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="classic">
        <div class="w-5 h-5 rounded bg-black mb-1.5 border border-slate-300"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Classic</div>
        <div class="text-[10px] text-slate-400">High-contrast solid black</div>
      </button>
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="indigo">
        <div class="w-5 h-5 rounded bg-indigo-600 mb-1.5"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Deep Indigo</div>
        <div class="text-[10px] text-slate-400">Rounded modern indigo</div>
      </button>
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="emerald">
        <div class="w-5 h-5 rounded bg-emerald-600 mb-1.5"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Emerald Dots</div>
        <div class="text-[10px] text-slate-400">Circular dots &amp; round eyes</div>
      </button>
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="sunset">
        <div class="w-5 h-5 rounded bg-orange-600 mb-1.5"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Sunset Amber</div>
        <div class="text-[10px] text-slate-400">Warm classy look</div>
      </button>
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="midnight">
        <div class="w-5 h-5 rounded bg-slate-900 mb-1.5 border border-slate-700"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Midnight Dark</div>
        <div class="text-[10px] text-slate-400">Sharp tech aesthetic</div>
      </button>
      <button type="button" class="preset-btn p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-left hover:border-slate-900 dark:hover:border-white bg-slate-50/50 dark:bg-slate-800/40 transition-colors cursor-pointer" data-preset="ocean">
        <div class="w-5 h-5 rounded bg-cyan-600 mb-1.5"></div>
        <div class="text-xs font-bold text-slate-900 dark:text-white">Ocean Blue</div>
        <div class="text-[10px] text-slate-400">Crisp cyan blue</div>
      </button>
    </div>
  </div>

  <!-- Tab 2: Colors -->
  <div id="tab-content-colors" class="custom-tab-pane hidden space-y-3" role="tabpanel">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <label for="color-fg" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Foreground (Dots &amp; Eyes)</label>
        <div class="flex items-center gap-2">
          <input type="color" id="color-fg" value="#000000" class="w-9 h-9 rounded-md cursor-pointer border border-slate-300 dark:border-slate-700 p-0.5 bg-transparent" aria-label="Foreground color picker" />
          <input type="text" id="color-fg-hex" value="#000000" maxlength="7" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white uppercase" aria-label="Foreground hex color" />
        </div>
      </div>
      <div>
        <label for="color-bg" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Background Color</label>
        <div class="flex items-center gap-2">
          <input type="color" id="color-bg" value="#ffffff" class="w-9 h-9 rounded-md cursor-pointer border border-slate-300 dark:border-slate-700 p-0.5 bg-transparent" aria-label="Background color picker" />
          <input type="text" id="color-bg-hex" value="#ffffff" maxlength="7" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white uppercase" aria-label="Background hex color" />
        </div>
      </div>
    </div>

    <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-400 cursor-pointer pt-1">
      <input type="checkbox" id="color-transparent-bg" class="rounded text-slate-900 focus:ring-slate-900" />
      <span>Transparent Background (ideal for vector SVG print overlays)</span>
    </label>
  </div>

  <!-- Tab 3: Shapes & Eyes -->
  <div id="tab-content-shapes" class="custom-tab-pane hidden space-y-3" role="tabpanel">
    <div>
      <span class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Module / Dot Pattern</span>
      <div class="grid grid-cols-3 gap-1.5 text-xs">
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-900 dark:border-white bg-slate-100 dark:bg-slate-800 font-bold cursor-pointer" data-shape-type="dot" data-val="square">Square</button>
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="dot" data-val="rounded">Rounded</button>
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="dot" data-val="dots">Dots</button>
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="dot" data-val="classy">Classy</button>
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="dot" data-val="classy-rounded">Smooth</button>
        <button type="button" class="shape-btn px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="dot" data-val="extra-rounded">Extra Round</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
      <div>
        <span class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Eye Outer Frame</span>
        <div class="grid grid-cols-3 gap-1.5 text-xs">
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-900 dark:border-white bg-slate-100 dark:bg-slate-800 font-bold cursor-pointer" data-shape-type="eye-frame" data-val="square">Square</button>
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="eye-frame" data-val="rounded">Rounded</button>
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="eye-frame" data-val="circle">Circle</button>
        </div>
      </div>
      <div>
        <span class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Eye Center Dot</span>
        <div class="grid grid-cols-3 gap-1.5 text-xs">
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-900 dark:border-white bg-slate-100 dark:bg-slate-800 font-bold cursor-pointer" data-shape-type="eye-dot" data-val="square">Square</button>
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="eye-dot" data-val="rounded">Rounded</button>
          <button type="button" class="shape-btn px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 cursor-pointer" data-shape-type="eye-dot" data-val="circle">Circle</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 4: Logo -->
  <div id="tab-content-logo" class="custom-tab-pane hidden space-y-3" role="tabpanel">
    <div>
      <label for="logo-file-input" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Upload Brand Logo</label>
      <input
        type="file"
        id="logo-file-input"
        accept="image/png,image/jpeg,image/jpg,image/webp,image/svg+xml"
        class="block w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-100 dark:file:bg-slate-800 file:text-slate-800 dark:file:text-slate-200 hover:file:bg-slate-200 cursor-pointer"
      />
      <p class="text-[10px] text-slate-400 mt-1">PNG, JPG, WebP, or SVG. Processed 100% locally in your browser.</p>
    </div>

    <div id="logo-controls" class="hidden space-y-2.5 pt-2 border-t border-slate-100 dark:border-slate-800">
      <div id="logo-recommendation-note" class="p-2 rounded-lg bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-200 dark:border-indigo-800 text-[11px] text-indigo-700 dark:text-indigo-300">
        ℹ️ Error correction was automatically set to <strong>High (30%)</strong> to keep the QR code reliably scannable with the logo.
      </div>

      <div>
        <div class="flex justify-between text-xs mb-1">
          <label for="logo-size-range" class="font-medium text-slate-600 dark:text-slate-400">Logo Scale</label>
          <span id="logo-size-val" class="font-mono text-slate-900 dark:text-white font-bold">25%</span>
        </div>
        <input type="range" id="logo-size-range" min="15" max="30" value="25" class="w-full accent-slate-900 dark:accent-white cursor-pointer" />
      </div>

      <div class="flex items-center justify-between pt-1">
        <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-400 cursor-pointer">
          <input type="checkbox" id="logo-clear-dots" checked class="rounded text-slate-900 focus:ring-slate-900" />
          <span>Clear dots behind logo</span>
        </label>
        <button type="button" id="logo-remove-btn" class="text-xs text-red-500 hover:underline font-semibold cursor-pointer">
          Remove
        </button>
      </div>
    </div>
  </div>

  <!-- Tab 5: Size & Settings -->
  <div id="tab-content-settings" class="custom-tab-pane hidden space-y-3" role="tabpanel">
    <div>
      <span class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Canvas Export Resolution</span>
      <div class="grid grid-cols-4 gap-1.5 text-xs">
        <button type="button" class="size-preset-btn py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 font-mono cursor-pointer" data-size="256">256px</button>
        <button type="button" class="size-preset-btn py-1.5 px-2 rounded-lg border border-slate-900 dark:border-white bg-slate-100 dark:bg-slate-800 font-bold font-mono cursor-pointer" data-size="512">512px</button>
        <button type="button" class="size-preset-btn py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 font-mono cursor-pointer" data-size="1024">1024px</button>
        <button type="button" class="size-preset-btn py-1.5 px-2 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 font-mono cursor-pointer" data-size="2048">2048px</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
      <div>
        <label for="error-correction-select" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Error Correction Level</label>
        <select id="error-correction-select" class="w-full px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs">
          <option value="L">L - Low (~7% recovery)</option>
          <option value="M" selected>M - Medium (~15% recovery)</option>
          <option value="Q">Q - Quartile (~25% recovery)</option>
          <option value="H">H - High (~30% recovery)</option>
        </select>
      </div>
      <div>
        <div class="flex justify-between text-xs mb-1">
          <label for="margin-range" class="font-semibold text-slate-700 dark:text-slate-300">Quiet Margin</label>
          <span id="margin-val" class="font-mono text-slate-900 dark:text-white font-bold">10px</span>
        </div>
        <input type="range" id="margin-range" min="4" max="40" value="10" class="w-full accent-slate-900 dark:accent-white cursor-pointer" />
      </div>
    </div>
  </div>

</div>
