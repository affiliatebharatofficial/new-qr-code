---
import {
  calculateQRSize,
  SCAN_DISTANCE_REFERENCE_TABLE,
  ERROR_CORRECTION_INFO,
  CONTENT_TYPE_DEFAULT_VERSIONS,
} from '../../lib/calculator/size';
import type { DistanceUnit, ErrorCorrectionLevel, QRContentType } from '../../lib/calculator/types';
import type { Locale } from '../../lib/i18n/config';
import { getCalculatorTranslations } from '../../lib/i18n/calculator';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getCalculatorTranslations(locale).size;

// Initial server-side default calculation (1 meter URL, Level M, 300 DPI)
const initialResult = calculateQRSize({
  scanDistance: 1,
  distanceUnit: 'm',
  contentType: 'url',
  errorCorrection: 'M',
  dpi: 300,
});
---

<div id="size-calculator-widget" class="space-y-8" data-locale={locale}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Interactive Inputs Form (7 Cols) -->
    <div class="lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📏</span> {t.inputsTitle}
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          {t.inputsDesc}
        </p>
      </div>

      <form id="size-calc-form" class="space-y-5" onsubmit="return false;">
        
        <!-- Input 1: Scan Distance -->
        <div class="space-y-2">
          <label for="calc-scan-distance" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            {t.distanceLabel} <span class="text-red-500">*</span>
          </label>
          <div class="flex gap-2">
            <input
              type="number"
              id="calc-scan-distance"
              value="1"
              min="0.05"
              step="any"
              required
              class="flex-1 px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              placeholder={t.distancePlaceholder}
            />
            <select
              id="calc-distance-unit"
              class="w-36 px-3 py-3 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="m" selected>{t.units.m}</option>
              <option value="cm">{t.units.cm}</option>
              <option value="ft">{t.units.ft}</option>
              <option value="in">{t.units.in}</option>
            </select>
          </div>
        </div>

        <!-- Input 2: Content Type & Version -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="calc-content-type" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              {t.contentTypeLabel}
            </label>
            <select
              id="calc-content-type"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="short_url">{t.contentTypes.shortUrl}</option>
              <option value="url" selected>{t.contentTypes.url}</option>
              <option value="wifi">{t.contentTypes.wifi}</option>
              <option value="vcard">{t.contentTypes.vcard}</option>
              <option value="text">{t.contentTypes.text}</option>
              <option value="app">{t.contentTypes.app}</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="calc-qr-version" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              QR Version
            </label>
            <select
              id="calc-qr-version"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="auto" selected>Auto (Estimated)</option>
              <option value="1">Version 1 (21 × 21)</option>
              <option value="2">Version 2 (25 × 25)</option>
              <option value="3">Version 3 (29 × 29)</option>
              <option value="4">Version 4 (33 × 33)</option>
              <option value="5">Version 5 (37 × 37)</option>
              <option value="6">Version 6 (41 × 41)</option>
              <option value="10">Version 10 (57 × 57)</option>
              <option value="20">Version 20 (97 × 97)</option>
            </select>
          </div>
        </div>

        <!-- Input 3: Error Correction Level & DPI -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="calc-ec-level" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              {t.ecLabel}
            </label>
            <select
              id="calc-ec-level"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="L">L — Low (~7%)</option>
              <option value="M" selected>M — Medium (~15%)</option>
              <option value="Q">Q — Quartile (~25%)</option>
              <option value="H">H — High (~30%)</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="calc-dpi-level" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              {t.dpiLabel}
            </label>
            <select
              id="calc-dpi-level"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="72">72 DPI (Web)</option>
              <option value="150">150 DPI (Screen / Poster)</option>
              <option value="300" selected>300 DPI (Commercial Print)</option>
              <option value="600">600 DPI (Fine Art)</option>
            </select>
          </div>
        </div>

        <!-- Quick Distance Presets Bar -->
        <div class="space-y-1.5 pt-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{t.presetsLabel}</span>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="0.3" data-unit="m">
              {t.presets.businessCard}
            </button>
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="0.5" data-unit="m">
              {t.presets.tableMenu}
            </button>
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="0.6" data-unit="m">
              {t.presets.flyer}
            </button>
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="1.5" data-unit="m">
              {t.presets.poster}
            </button>
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="2.5" data-unit="m">
              {t.presets.windowSign}
            </button>
            <button type="button" class="preset-dist-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-val="10" data-unit="m">
              {t.presets.billboard}
            </button>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Real-time Recommended Output Card (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Primary Output Highlight Card -->
      <div class="bg-gradient-to-br from-indigo-900 via-slate-900 to-slate-950 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-indigo-500/30 space-y-5">
        <div class="flex items-center justify-between border-b border-indigo-500/20 pb-3">
          <span class="text-[10px] uppercase font-black tracking-widest text-indigo-400">
            {t.recommendedSize}
          </span>
          <span id="output-status-pill" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Optimal
          </span>
        </div>

        <!-- Prominent Physical Dimensions -->
        <div class="space-y-1">
          <div id="output-size-primary" class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            {initialResult.recommendedSize.widthCm} × {initialResult.recommendedSize.heightCm} cm
          </div>
          <div id="output-size-secondary" class="text-xs sm:text-sm text-slate-300 font-mono">
            {initialResult.recommendedSize.widthInches} × {initialResult.recommendedSize.heightInches} in ({initialResult.recommendedSize.widthMm} × {initialResult.recommendedSize.heightMm} mm)
          </div>
        </div>

        <!-- Raster Pixel Output -->
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2 text-xs">
          <div class="flex justify-between items-center text-slate-300">
            <span>{t.rasterPixels}:</span>
            <span id="output-raster-px" class="font-bold text-white font-mono">
              {initialResult.rasterResolution.widthPx} × {initialResult.rasterResolution.heightPx} px
            </span>
          </div>
          <div class="flex justify-between items-center text-slate-400 text-[11px]">
            <span>Pixel Density:</span>
            <span id="output-raster-dpi" class="font-mono text-indigo-300">@ {initialResult.rasterResolution.dpi} DPI</span>
          </div>
          <div class="flex justify-between items-center text-slate-400 text-[11px] pt-1 border-t border-white/5">
            <span>Prepress Vector:</span>
            <span class="font-bold text-emerald-400">Vector SVG</span>
          </div>
        </div>

        <!-- Matrix Specifications -->
        <div class="grid grid-cols-2 gap-3 text-xs pt-1">
          <div class="p-3 rounded-xl bg-white/5 border border-white/5">
            <span class="text-[10px] text-slate-400 block uppercase">Module Size</span>
            <span id="output-module-size" class="font-bold text-white font-mono">
              {initialResult.qrSpecs.estimatedModuleSizeMm} mm
            </span>
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5">
            <span class="text-[10px] text-slate-400 block uppercase">{t.quietZone}</span>
            <span id="output-quiet-zone" class="font-bold text-white font-mono">
              {initialResult.qrSpecs.quietZoneWidthMm} mm
            </span>
          </div>
        </div>

        <!-- Contextual Warnings Box -->
        <div id="output-warnings-container" class="space-y-2">
          {initialResult.warnings.map((w) => (
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs leading-relaxed flex items-start gap-2">
              <span class="text-amber-400 font-bold shrink-0">⚠️</span>
              <span>{w}</span>
            </div>
          ))}
        </div>

        <!-- Call to Action Buttons -->
        <div class="pt-2 space-y-2.5">
          <a
            id="create-qr-cta"
            href="/"
            class="block w-full py-3.5 px-4 text-center rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-colors shadow-lg"
          >
            Generate QR Code Now &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  import { calculateQRSize } from '../../lib/calculator/size';
  import type { DistanceUnit, ErrorCorrectionLevel, QRContentType } from '../../lib/calculator/types';

  function initSizeCalculator() {
    const form = document.getElementById('size-calc-form') as HTMLFormElement | null;
    if (!form) return;

    const distanceInput = document.getElementById('calc-scan-distance') as HTMLInputElement;
    const distanceUnitSelect = document.getElementById('calc-distance-unit') as HTMLSelectElement;
    const contentTypeSelect = document.getElementById('calc-content-type') as HTMLSelectElement;
    const qrVersionSelect = document.getElementById('calc-qr-version') as HTMLSelectElement;
    const ecLevelSelect = document.getElementById('calc-ec-level') as HTMLSelectElement;
    const dpiSelect = document.getElementById('calc-dpi-level') as HTMLSelectElement;

    // Output elements
    const outputPrimary = document.getElementById('output-size-primary');
    const outputSecondary = document.getElementById('output-size-secondary');
    const outputRasterPx = document.getElementById('output-raster-px');
    const outputRasterDpi = document.getElementById('output-raster-dpi');
    const outputModuleSize = document.getElementById('output-module-size');
    const outputQuietZone = document.getElementById('output-quiet-zone');
    const warningsContainer = document.getElementById('output-warnings-container');

    function updateCalculations() {
      const distance = parseFloat(distanceInput.value) || 1;
      const unit = distanceUnitSelect.value as DistanceUnit;
      const contentType = contentTypeSelect.value as QRContentType;
      const ec = ecLevelSelect.value as ErrorCorrectionLevel;
      const dpi = parseInt(dpiSelect.value, 10) || 300;
      const versionVal = qrVersionSelect.value;
      const qrVersion = versionVal === 'auto' ? undefined : parseInt(versionVal, 10);

      const result = calculateQRSize({
        scanDistance: distance,
        distanceUnit: unit,
        contentType,
        qrVersion,
        errorCorrection: ec,
        dpi,
      });

      if (outputPrimary) {
        outputPrimary.textContent = `${result.recommendedSize.widthCm} × ${result.recommendedSize.heightCm} cm`;
      }
      if (outputSecondary) {
        outputSecondary.textContent = `${result.recommendedSize.widthInches} × ${result.recommendedSize.heightInches} in (${result.recommendedSize.widthMm} × ${result.recommendedSize.heightMm} mm)`;
      }
      if (outputRasterPx) {
        outputRasterPx.textContent = `${result.rasterResolution.widthPx} × ${result.rasterResolution.heightPx} px`;
      }
      if (outputRasterDpi) {
        outputRasterDpi.textContent = `@ ${result.rasterResolution.dpi} DPI`;
      }
      if (outputModuleSize) {
        outputModuleSize.textContent = `${result.qrSpecs.estimatedModuleSizeMm} mm`;
      }
      if (outputQuietZone) {
        outputQuietZone.textContent = `${result.qrSpecs.quietZoneWidthMm} mm`;
      }

      if (warningsContainer) {
        warningsContainer.innerHTML = '';
        result.warnings.forEach((warning) => {
          const warnEl = document.createElement('div');
          warnEl.className = 'p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs leading-relaxed flex items-start gap-2';
          warnEl.innerHTML = `<span class="text-amber-400 font-bold shrink-0">⚠️</span><span>${warning}</span>`;
          warningsContainer.appendChild(warnEl);
        });
      }
    }

    // Attach event listeners
    [distanceInput, distanceUnitSelect, contentTypeSelect, qrVersionSelect, ecLevelSelect, dpiSelect].forEach((el) => {
      el?.addEventListener('input', updateCalculations);
      el?.addEventListener('change', updateCalculations);
    });

    // Preset buttons
    document.querySelectorAll('.preset-dist-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        const unit = btn.getAttribute('data-unit');
        if (val && distanceInput) distanceInput.value = val;
        if (unit && distanceUnitSelect) distanceUnitSelect.value = unit;
        updateCalculations();
      });
    });
  }

  // Initialize on load and on Astro view transitions
  initSizeCalculator();
  document.addEventListener('astro:page-load', initSizeCalculator);
</script>
