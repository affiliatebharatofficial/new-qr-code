---
import {
  calculatePrintReadiness,
  PRINT_PRESETS,
} from '../../lib/calculator/print';
import type { DistanceUnit, ErrorCorrectionLevel, PrintMaterial, SizeUnit } from '../../lib/calculator/types';
import type { Locale } from '../../lib/i18n/config';
import { getCalculatorTranslations } from '../../lib/i18n/calculator';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getCalculatorTranslations(locale).print;

// Initial server-side default calculation (10 x 10 cm, 300 DPI, Poster, Level M)
const initialResult = calculatePrintReadiness({
  physicalWidth: 10,
  physicalHeight: 10,
  sizeUnit: 'cm',
  dpi: 300,
  errorCorrection: 'M',
  printMaterial: 'poster',
});
---

<div id="print-calculator-widget" class="space-y-8" data-locale={locale}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Interactive Print Form (7 Cols) -->
    <div class="lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🖨️</span> {t.inputsTitle}
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          {t.inputsDesc}
        </p>
      </div>

      <form id="print-calc-form" class="space-y-5" onsubmit="return false;">
        
        <!-- Input 1: Physical Size & Units -->
        <div class="space-y-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            {t.widthLabel} &amp; {t.heightLabel} <span class="text-red-500">*</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div>
              <span class="text-[10px] text-slate-400 font-semibold block mb-0.5">{t.widthLabel}:</span>
              <input
                type="number"
                id="print-width"
                value="10"
                min="0.1"
                step="any"
                required
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                placeholder="10"
              />
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-semibold block mb-0.5">{t.heightLabel}:</span>
              <input
                type="number"
                id="print-height"
                value="10"
                min="0.1"
                step="any"
                required
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                placeholder="10"
              />
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-semibold block mb-0.5">{t.unitLabel}:</span>
              <select
                id="print-unit"
                class="w-full px-3 py-3 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              >
                <option value="cm" selected>Centimeters (cm)</option>
                <option value="mm">Millimeters (mm)</option>
                <option value="in">Inches (in)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Input 2: Printer DPI & Error Correction -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <label for="print-dpi" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              {t.dpiLabel}
            </label>
            <select
              id="print-dpi"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="300" selected>300 DPI (Commercial Standard)</option>
              <option value="600">600 DPI (Offset / Fine Magazine)</option>
              <option value="150">150 DPI (Poster / Digital Sign)</option>
              <option value="100">100 DPI (Billboard / Mesh Banner)</option>
              <option value="72">72 DPI (Web Only - Not for Print)</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="print-ec" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Error Correction
            </label>
            <select
              id="print-ec"
              class="w-full px-3.5 py-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="L">L — Low (~7% recovery)</option>
              <option value="M" selected>M — Medium (~15% standard)</option>
              <option value="Q">Q — Quartile (~25% industrial)</option>
              <option value="H">H — High (~30% logo embedding)</option>
            </select>
          </div>
        </div>

        <!-- Quick Commercial Print Presets -->
        <div class="space-y-1.5 pt-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{t.presetsLabel}</span>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="3" data-h="3" data-unit="cm" data-dpi="300" data-mat="business_card">
              {t.presets.businessCard}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="5" data-h="5" data-unit="cm" data-dpi="300" data-mat="flyer">
              {t.presets.flyer}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="6" data-h="6" data-unit="cm" data-dpi="300" data-mat="menu">
              {t.presets.menu}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="3.5" data-h="3.5" data-unit="cm" data-dpi="300" data-mat="packaging">
              {t.presets.packaging}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="15" data-h="15" data-unit="cm" data-dpi="300" data-mat="poster">
              {t.presets.poster}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="20" data-h="20" data-unit="cm" data-dpi="150" data-mat="window_sign">
              {t.presets.windowSign}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="30" data-h="30" data-unit="cm" data-dpi="150" data-mat="banner">
              {t.presets.banner}
            </button>
            <button type="button" class="print-preset-btn px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 text-slate-700 dark:text-slate-300 font-semibold cursor-pointer transition-colors" data-w="100" data-h="100" data-unit="cm" data-dpi="100" data-mat="billboard">
              {t.presets.billboard}
            </button>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Print Prepress Specifications (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Primary Output Highlight Card -->
      <div class="bg-gradient-to-br from-purple-950 via-slate-900 to-slate-950 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-purple-500/30 space-y-5">
        <div class="flex items-center justify-between border-b border-purple-500/20 pb-3">
          <span class="text-[10px] uppercase font-black tracking-widest text-purple-400">
            {t.resultsTitle}
          </span>
          <span id="print-readiness-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            {t.statusReady}
          </span>
        </div>

        <!-- Prominent Pixel Grid Output -->
        <div class="space-y-1">
          <div id="print-pixel-output" class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            {initialResult.rasterOutput.widthPx} × {initialResult.rasterOutput.heightPx} px
          </div>
          <div id="print-size-output" class="text-xs sm:text-sm text-slate-300 font-mono">
            {initialResult.physicalDimensions.widthCm} × {initialResult.physicalDimensions.heightCm} cm ({initialResult.physicalDimensions.widthInches} × {initialResult.physicalDimensions.heightInches} in)
          </div>
        </div>

        <!-- Specifications Breakdown -->
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2 text-xs">
          <div class="flex justify-between items-center text-slate-300">
            <span>{t.recommendedDpi}:</span>
            <span id="print-spec-dpi" class="font-bold text-white font-mono">{initialResult.rasterOutput.dpi} DPI</span>
          </div>
          <div class="flex justify-between items-center text-slate-300">
            <span>{t.maxScanDistance}:</span>
            <span id="print-spec-distance" class="font-bold text-indigo-300 font-mono">{initialResult.opticalDistance.recommendedMaxDistanceMeters} m</span>
          </div>
          <div class="flex justify-between items-center text-slate-400 text-[11px] pt-1 border-t border-white/5">
            <span>{t.vectorRecommendation}:</span>
            <span class="font-bold text-emerald-400 font-mono">Vector SVG</span>
          </div>
        </div>

        <!-- Prepress Quality Checklist -->
        <div class="space-y-2 pt-1 text-xs">
          <div class="text-[11px] font-bold text-purple-300 uppercase tracking-wider">{t.prepressChecklistTitle}</div>
          <div class="space-y-1.5 text-slate-300 text-[11px]">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{t.checklist.contrast}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{t.checklist.quietZone}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{t.checklist.finish}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{t.checklist.vector}</span>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="pt-2 space-y-2.5">
          <a
            href="/"
            class="block w-full py-3.5 px-4 text-center rounded-2xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition-colors shadow-lg"
          >
            Create Vector SVG QR Code &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  import { calculatePrintReadiness } from '../../lib/calculator/print';
  import type { ErrorCorrectionLevel, PrintMaterial, SizeUnit } from '../../lib/calculator/types';

  function initPrintCalculator() {
    const form = document.getElementById('print-calc-form') as HTMLFormElement | null;
    if (!form) return;

    const widthInput = document.getElementById('print-width') as HTMLInputElement;
    const heightInput = document.getElementById('print-height') as HTMLInputElement;
    const unitSelect = document.getElementById('print-unit') as HTMLSelectElement;
    const dpiSelect = document.getElementById('print-dpi') as HTMLSelectElement;
    const ecSelect = document.getElementById('print-ec') as HTMLSelectElement;

    // Output elements
    const pixelOutput = document.getElementById('print-pixel-output');
    const sizeOutput = document.getElementById('print-size-output');
    const specDpi = document.getElementById('print-spec-dpi');
    const specDistance = document.getElementById('print-spec-distance');
    const readinessBadge = document.getElementById('print-readiness-badge');

    function updateCalculations() {
      const w = parseFloat(widthInput.value) || 10;
      const h = parseFloat(heightInput.value) || 10;
      const unit = unitSelect.value as SizeUnit;
      const dpi = parseInt(dpiSelect.value, 10) || 300;
      const ec = ecSelect.value as ErrorCorrectionLevel;

      const result = calculatePrintReadiness({
        physicalWidth: w,
        physicalHeight: h,
        sizeUnit: unit,
        dpi,
        errorCorrection: ec,
      });

      if (pixelOutput) {
        pixelOutput.textContent = `${result.rasterOutput.widthPx} × ${result.rasterOutput.heightPx} px`;
      }
      if (sizeOutput) {
        sizeOutput.textContent = `${result.physicalDimensions.widthCm} × ${result.physicalDimensions.heightCm} cm (${result.physicalDimensions.widthInches} × ${result.physicalDimensions.heightInches} in)`;
      }
      if (specDpi) {
        specDpi.textContent = `${result.rasterOutput.dpi} DPI`;
      }
      if (specDistance) {
        specDistance.textContent = `${result.opticalDistance.recommendedMaxDistanceMeters} m`;
      }
      if (readinessBadge) {
        if (result.rasterOutput.dpi >= 300) {
          readinessBadge.textContent = 'Print Ready (300+ DPI)';
          readinessBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        } else if (result.rasterOutput.dpi >= 150) {
          readinessBadge.textContent = 'Acceptable (150 DPI)';
          readinessBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30';
        } else {
          readinessBadge.textContent = 'Low Resolution (< 150 DPI)';
          readinessBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        }
      }
    }

    [widthInput, heightInput, unitSelect, dpiSelect, ecSelect].forEach((el) => {
      el?.addEventListener('input', updateCalculations);
      el?.addEventListener('change', updateCalculations);
    });

    // Presets
    document.querySelectorAll('.print-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const w = btn.getAttribute('data-w');
        const h = btn.getAttribute('data-h');
        const unit = btn.getAttribute('data-unit');
        const dpi = btn.getAttribute('data-dpi');

        if (w && widthInput) widthInput.value = w;
        if (h && heightInput) heightInput.value = h;
        if (unit && unitSelect) unitSelect.value = unit;
        if (dpi && dpiSelect) dpiSelect.value = dpi;

        updateCalculations();
      });
    });
  }

  initPrintCalculator();
  document.addEventListener('astro:page-load', initPrintCalculator);
</script>
