---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'banner';
  class?: string;
}

const { slotId = 'default-ad', format = 'horizontal', class: className = '' } = Astro.props;

const formatStyles = {
  horizontal: 'h-24 max-w-4xl',
  rectangle: 'h-64 max-w-sm',
  banner: 'h-16 max-w-2xl',
};
---

<aside class={`my-8 mx-auto w-full flex items-center justify-center bg-slate-100/60 dark:bg-slate-900/40 border border-dashed border-slate-300 dark:border-slate-800 rounded-2xl overflow-hidden p-3 ${formatStyles[format]} ${className}`} aria-label="Sponsored Advertisement">
  <div class="flex flex-col items-center justify-center text-center">
    <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-400 dark:text-slate-500 mb-1">
      Advertisement
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-600">
      Display Ads Space ({format})
    </span>
  </div>
</aside>
