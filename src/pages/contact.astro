---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Support & Feedback" description="Get in touch with our engineering and support team for inquiries, bug reports, and feedback.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8 sm:p-12 shadow-sm space-y-6">
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Contact Us</h1>
        <p class="text-sm text-slate-500">Have questions, feature requests, or enterprise inquiries? Send us a message.</p>
      </div>

      <form id="contact-form" class="space-y-4" onsubmit="alert('✓ Message sent successfully! We will get back to you shortly.'); return false;">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Your Name</label>
          <input type="text" required class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm" placeholder="John Doe" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Email Address</label>
          <input type="email" required class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm" placeholder="you@example.com" />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Message</label>
          <textarea rows="4" required class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm" placeholder="How can we assist you?"></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
