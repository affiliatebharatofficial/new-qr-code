---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us & Legal Support — Free QR Code Generator" 
  description="Official Contact, Technical Support, Abuse Reporting, and Legal Inquiries Desk for freeqrcode-generator.com. Connect with engineering, compliance, or DMCA representatives."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="space-y-8">
      
      <!-- Top Title -->
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Support & Compliance Desk</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Contact Us & Support Center
        </h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Have questions regarding QR code generation, enterprise API integration, billing assistance, or legal compliance? Our technical and legal teams are here to assist you.
        </p>
      </div>

      <!-- Department Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- 1. Customer Support -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm">
            💬
          </div>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Customer Support</h2>
          <p class="text-xs text-slate-500 leading-relaxed">General inquiries, vector asset export issues, design customization, and account setup assistance.</p>
          <a href="mailto:support@freeqrcode-generator.com" class="inline-block text-xs text-indigo-600 dark:text-indigo-400 font-bold underline pt-1">
            support@freeqrcode-generator.com
          </a>
        </div>

        <!-- 2. Legal & DMCA -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-xl bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm">
            ⚖️
          </div>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Legal & DMCA Desk</h2>
          <p class="text-xs text-slate-500 leading-relaxed">Statutory privacy rights (GDPR/CCPA), intellectual property claims, trademark inquiries, and DMCA takedowns.</p>
          <a href="mailto:legal@freeqrcode-generator.com" class="inline-block text-xs text-indigo-600 dark:text-indigo-400 font-bold underline pt-1">
            legal@freeqrcode-generator.com
          </a>
        </div>

        <!-- 3. Abuse & Security -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm">
            🚨
          </div>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Abuse & Security</h2>
          <p class="text-xs text-slate-500 leading-relaxed">Urgent reporting of malicious dynamic links, phishing campaigns, malware URLs, or security vulnerabilities.</p>
          <a href="mailto:abuse@freeqrcode-generator.com" class="inline-block text-xs text-red-600 dark:text-red-400 font-bold underline pt-1">
            abuse@freeqrcode-generator.com
          </a>
        </div>
      </div>

      <!-- Main Form & Details Split -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        
        <!-- Left: Interactive Form (3 Cols) -->
        <div class="lg:col-span-3 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-card space-y-4">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Send Us a Direct Message</h2>
            <p class="text-xs text-slate-500">Fill in the form below and our representative will respond within 24–48 business hours.</p>
          </div>

          <div id="contact-feedback" class="hidden p-3 rounded-lg text-xs bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 font-medium"></div>

          <form id="official-contact-form" class="space-y-3.5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  required 
                  placeholder="Jane Smith"
                  class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white" 
                />
              </div>
              <div>
                <label for="contact-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  Official Email <span class="text-red-500">*</span>
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  required 
                  placeholder="jane@company.com"
                  class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white" 
                />
              </div>
            </div>

            <div>
              <label for="contact-dept" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Department / Inquiry Type
              </label>
              <select 
                id="contact-dept" 
                class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white"
              >
                <option value="support">Technical Support & Generator Assistance</option>
                <option value="billing">Billing & Subscription Inquiry</option>
                <option value="legal">Legal, Privacy & Compliance (GDPR/CCPA)</option>
                <option value="abuse">Report Malicious QR Code / Phishing Link</option>
                <option value="enterprise">Enterprise Custom Development</option>
              </select>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Subject Line <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                id="contact-subject" 
                required 
                placeholder="Brief summary of your inquiry"
                class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white" 
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Detailed Message <span class="text-red-500">*</span>
              </label>
              <textarea 
                id="contact-message" 
                rows="4" 
                required 
                placeholder="Please describe your inquiry, including any relevant short codes, error messages, or account emails..."
                class="w-full px-3.5 py-2 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white"
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full py-2.5 px-4 rounded-lg font-bold text-xs bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors shadow-subtle cursor-pointer"
            >
              Submit Official Inquiry
            </button>
          </form>
        </div>

        <!-- Right: Legal & Security Notice (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
          
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-card space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
              Corporate & Service Information
            </h3>
            <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
              <div>
                <span class="block font-semibold text-slate-900 dark:text-white">Platform Domain:</span>
                <span class="font-mono">https://freeqrcode-generator.com</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900 dark:text-white">Infrastructure:</span>
                <span>Cloudflare Global Edge Serverless Architecture</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900 dark:text-white">Support Availability:</span>
                <span>Monday – Friday: 9:00 AM – 6:00 PM (UTC)</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900 dark:text-white">Urgent Abuse Response:</span>
                <span>24/7 Automated Moderation & Takedown Queue</span>
              </div>
            </div>
          </div>

          <div class="bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 space-y-2 text-xs text-slate-600 dark:text-slate-400">
            <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span>🛡️</span> Security & Vulnerability Reporting
            </h3>
            <p>
              If you have discovered a security vulnerability affecting our edge routing or client-side generator scripts, please submit a responsible disclosure report directly to <a href="mailto:security@freeqrcode-generator.com" class="text-indigo-600 dark:text-indigo-400 font-bold underline">security@freeqrcode-generator.com</a>. We acknowledge all reports within 24 hours.
            </p>
          </div>

        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('official-contact-form') as HTMLFormElement;
  const feedbackDiv = document.getElementById('contact-feedback');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!contactForm.checkValidity()) {
      contactForm.reportValidity();
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = 'Submitting...';
    }

    setTimeout(() => {
      if (feedbackDiv) {
        feedbackDiv.innerText = '✓ Thank you. Your official inquiry has been logged. Our department will review your message and respond shortly.';
        feedbackDiv.classList.remove('hidden');
      }
      contactForm.reset();
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Submit Official Inquiry';
      }
    }, 600);
  });
</script>
