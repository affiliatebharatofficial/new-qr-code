---
import BaseLayout from '../layouts/BaseLayout.astro';

const popularLinks = [
  { name: 'QR Code Generator', href: '/' },
  { name: 'Wi-Fi QR Generator', href: '/wifi-qr-code-generator' },
  { name: 'vCard QR Generator', href: '/vcard-qr-code-generator' },
  { name: 'WhatsApp QR Generator', href: '/whatsapp-qr-code-generator' },
  { name: 'Digital Business Card', href: '/digital-business-card' },
  { name: 'Restaurant Menu QR', href: '/restaurant-menu-qr-code' },
  { name: 'Pricing & Plans', href: '/pricing' },
  { name: 'Guides & Tutorials', href: '/guides' },
];
---

<BaseLayout
  title="Page Not Found (404)"
  description="The page you are looking for does not exist or has been moved."
  noIndex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-20 sm:py-28 text-center space-y-8">
    <div class="w-20 h-20 rounded-3xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto text-3xl font-black shadow-inner">
      404
    </div>

    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Page Not Found
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">
        Sorry, the page or QR destination you were looking for doesn't exist, has expired, or was moved.
      </p>
    </div>

    <div class="pt-4 flex items-center justify-center gap-3">
      <a
        href="/"
        class="px-6 py-3 rounded-2xl font-bold text-xs sm:text-sm bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/25 transition-all"
      >
        &larr; Return to Homepage
      </a>
      <a
        href="/pricing"
        class="px-6 py-3 rounded-2xl font-bold text-xs sm:text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 transition-all"
      >
        View Pricing
      </a>
    </div>

    <div class="pt-10 border-t border-slate-200 dark:border-slate-800 text-left">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 text-center">
        Popular QR Code Tools
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {popularLinks.map((l) => (
          <a
            href={l.href}
            class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/60 hover:border-indigo-500 text-xs font-semibold text-slate-700 dark:text-slate-300 text-center hover:text-indigo-600 transition-colors shadow-2xs"
          >
            {l.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
