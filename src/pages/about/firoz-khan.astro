---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://freeqrcode-generator.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://freeqrcode-generator.com/about' },
    { '@type': 'ListItem', position: 3, name: 'Firoz Khan', item: 'https://freeqrcode-generator.com/about/firoz-khan' },
  ],
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Firoz Khan',
  jobTitle: 'Full Stack Developer',
  url: 'https://freeqrcode-generator.com/about/firoz-khan',
  description: 'Full Stack Developer behind FreeQRCode-Generator.com and the FK Digital Media development brand.',
  sameAs: [
    'https://www.linkedin.com/in/firoz-khan-1153358a/',
    'https://github.com/fkdigitalmedia',
    'https://www.instagram.com/rtibyfiroz/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'FK Digital Media',
    url: 'https://freeqrcode-generator.com',
  },
};
---

<BaseLayout
  title="Firoz Khan — Full Stack Developer & Platform Maintainer"
  description="Firoz Khan is the Full Stack Developer behind FreeQRCode-Generator.com and the FK Digital Media development brand, responsible for platform engineering and maintenance."
  jsonLd={[breadcrumbs, personJsonLd]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500 dark:text-slate-400">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a></li>
        <li><span>/</span></li>
        <li><a href="/about" class="hover:text-indigo-600 dark:hover:text-indigo-400">About</a></li>
        <li><span>/</span></li>
        <li class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">Firoz Khan</li>
      </ol>
    </nav>

    <!-- Header / Bio Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-indigo-700 flex items-center justify-center text-white font-extrabold text-2xl shadow-lg shadow-indigo-500/25 shrink-0">
            FK
          </div>
          <div class="space-y-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
              Platform Creator &amp; Maintainer
            </span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              Firoz Khan
            </h1>
            <p class="text-sm font-medium text-slate-600 dark:text-slate-300">
              Full Stack Developer &bull; FK Digital Media
            </p>
          </div>
        </div>

        <!-- Verified Profile Links -->
        <div class="flex flex-wrap sm:flex-col gap-2 shrink-0">
          <a
            href="https://www.linkedin.com/in/firoz-khan-1153358a/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-800 transition-all"
          >
            <svg class="w-4 h-4 fill-current text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn Profile</span>
          </a>

          <a
            href="https://github.com/fkdigitalmedia"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-800 transition-all"
          >
            <svg class="w-4 h-4 fill-current text-slate-800 dark:text-slate-200" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub Profile</span>
          </a>

          <a
            href="https://www.instagram.com/rtibyfiroz/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 border border-slate-200 dark:border-slate-700 hover:border-indigo-300 dark:hover:border-indigo-800 transition-all"
          >
            <svg class="w-4 h-4 fill-current text-pink-600 dark:text-pink-400" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Instagram Profile</span>
          </a>
        </div>
      </div>

      <!-- Positioning Statement -->
      <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        <strong>Firoz Khan</strong> is the Full Stack Developer behind <strong>FreeQRCode-Generator.com</strong> and the <strong>FK Digital Media</strong> development brand. He is responsible for the technical development, implementation, maintenance, and ongoing improvement of the platform.
      </div>
    </div>

    <!-- Technical Responsibilities Grid -->
    <div class="space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
        Project Scope &amp; Technical Responsibilities
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        As the sole developer and maintainer of FreeQRCode-Generator.com, Firoz Khan actively oversees all engineering facets of the application:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
          <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-600 dark:text-indigo-400">💻</span> Full-Stack Web Development
          </div>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Constructed with Astro, TypeScript, and Tailwind CSS to ensure low client payload, clean architecture, and rapid load times.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
          <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-600 dark:text-indigo-400">⚙️</span> QR Generation &amp; Rendering Pipeline
          </div>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Implementation of client-side barcode generation engines, SVG vector math calculations, PNG export resolution controls, and contrast checking algorithms.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
          <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-600 dark:text-indigo-400">☁️</span> Edge Routing &amp; Cloud Infrastructure
          </div>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Configuring Cloudflare Pages and Workers edge network for dynamic short-code routing, regional latency minimization, and high availability.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
          <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-indigo-600 dark:text-indigo-400">🔒</span> Privacy Architecture &amp; Security
          </div>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Enforcing zero-server-storage guarantees for static QR generators and maintaining responsible disclosure channels for bug and security reporting.
          </p>
        </div>
      </div>
    </div>

    <!-- FK Digital Media Section -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 space-y-3">
      <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
        About FK Digital Media
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        <strong>FK Digital Media</strong> is the independent development brand associated with Firoz Khan's web projects, including FreeQRCode-Generator.com. It represents an independent engineering initiative focused on building accessible, lightweight, privacy-conscious digital tools without intrusive advertising walls or mandatory account requirements for basic features.
      </p>
      <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold">
        <a href="/about" class="text-indigo-600 dark:text-indigo-400 hover:underline">
          &larr; Return to About Us
        </a>
        <a href="/report-problem" class="text-slate-600 dark:text-slate-400 hover:underline">
          Report a Technical Problem &rarr;
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
