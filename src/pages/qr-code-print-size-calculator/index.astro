---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QRPrintSizeCalculator from '../../components/calculator/QRPrintSizeCalculator.astro';
import { PRINT_PRESETS } from '../../lib/calculator/print';
import { extractLocaleFromPath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n/config';
import { getPrintCalculatorPageData } from '../../lib/i18n/content/calculatorPages';

const currentPath = Astro.url.pathname;
const { locale } = extractLocaleFromPath(currentPath);
const printData = getPrintCalculatorPageData(locale);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://freeqrcode-generator.com/' },
    { '@type': 'ListItem', position: 2, name: printData.h1, item: 'https://freeqrcode-generator.com/qr-code-print-size-calculator' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: printData.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={printData.title}
  description={printData.description}
  locale={locale}
  jsonLd={[breadcrumbs, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
    
    <!-- Top Header -->
    <div class="text-center space-y-3 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
        <span>🖨️</span> Prepress Print Calculator
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        {printData.h1}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        {printData.subheadline}
      </p>
    </div>

    <!-- Print Calculator Widget -->
    <QRPrintSizeCalculator locale={locale} />

    <!-- Print Presets Grid Section -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📦</span> {printData.tableTitle}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {PRINT_PRESETS.map((preset) => (
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900 dark:text-white">{preset.category}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 font-bold">
                {preset.widthCm} × {preset.heightCm} cm
              </span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              {preset.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Educational Prepress & Print Quality Content -->
    <article class="prose dark:prose-invert max-w-none space-y-8 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-200 dark:border-slate-800 pt-10">
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
          {printData.overviewTitle}
        </h2>
        {printData.overviewParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </section>
    </article>

    <!-- Structured FAQ Section -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {printData.faqsTitle}
        </h2>
      </div>

      <div class="divide-y divide-slate-100 dark:divide-slate-800 space-y-4">
        {printData.faqs.map((faq) => (
          <div class="pt-4 space-y-1.5">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white flex items-start gap-2">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">Q:</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-5">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Tools & Navigation Links -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-bold text-slate-900 dark:text-white">Related Tools:</span>
        <a href="/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Code Generator</a>
        <span>•</span>
        <a href="/qr-code-size-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Code Size &amp; Distance Calculator</a>
        <span>•</span>
        <a href="/guides" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Guides</a>
      </div>

      <div>
        <a href="/" class="px-5 py-2.5 rounded-xl font-bold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors">
          Generate Print-Ready QR &rarr;
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
