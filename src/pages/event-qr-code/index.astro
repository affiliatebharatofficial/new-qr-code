---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QRGenerator from '../../components/qr/QRGenerator.astro';
import LandingContent from '../../components/seo/LandingContent.astro';

const overviewTitle = 'Event QR Codes for Invitations, RSVPs & Stationery';
const overviewParagraphs = [
  'An Event QR code on invitations and stationery bridges the gap between luxury printed paper and digital smartphone calendars. When guests scan the printed code with their camera, their device immediately prompts them to save the event date, start and end times, ceremony or reception venue address, and dress code notes straight into Apple Calendar, Google Calendar, or Microsoft Outlook.',
  'Traditional printed invitations suffer from high "forgot-the-date" rates because guests set the physical card aside on a mantelpiece or fridge without typing the schedule into their phones. An RSVP Event QR code eliminates this friction in under two seconds, setting automatic calendar notifications 24 hours and 2 hours before your event begins.',
  'Whether you are designing bespoke wedding invitations, milestone birthday announcements, charity gala passes, or corporate dinner stationery, this client-side generator creates print-ready Vector SVG and high-resolution PNG codes with custom colors and elegant styling.'
];

const sectors = [
  {
    name: 'Luxury Wedding Stationery Designers',
    description: 'Print discreet, elegant codes on the back of formal wedding invitations and save-the-date cards.',
    benefit: 'Prevents guest calendar scheduling conflicts months in advance.'
  },
  {
    name: 'Charity Galas & Benefit Dinners',
    description: 'Include on formal donor banquet invitations and VIP table place cards.',
    benefit: 'Directs patrons to the ballroom on schedule with accurate venue GPS addresses.'
  },
  {
    name: 'Milestone Birthdays & Anniversaries',
    description: 'Add to custom printed postcards and party invitations sent to family and friends.',
    benefit: 'Ensures older and younger guests alike save the party time with one simple camera scan.'
  },
  {
    name: 'Concert & Theater Ticket Envelopes',
    description: 'Print on physical ticket sleeves, theater playbills, and box office confirmation cards.',
    benefit: 'Minimizes late arrivals by embedding curtain time reminders on mobile phones.'
  },
  {
    name: 'Alumni Reunions & University Formals',
    description: 'Incorporate into printed reunion booklets, homecoming mailers, and badge lanyards.',
    benefit: 'Coordinates multi-day campus activities effortlessly across attendees.'
  },
  {
    name: 'Private Dining & Pop-Up Supper Clubs',
    description: 'Display on reservation confirmation cards and secret dining location invitations.',
    benefit: 'Locks in attendee attendance for limited-seating culinary experiences.'
  }
];

const howItWorks = [
  {
    title: '1. Specify Invitation Details',
    description: 'Fill in your celebration title, exact ceremony/reception start and finish times, physical venue address, and host notes.'
  },
  {
    title: '2. Match Your Stationery Palette',
    description: 'Customize colors to match your wedding or brand palette—deep navy, forest green, champagne gold, or classic charcoal.'
  },
  {
    title: '3. Download Print-Ready Vector SVG',
    description: 'Export as high-precision Vector SVG for letterpress, foil stamping, or digital stationery printing at 300+ DPI.'
  }
];

const useCases = [
  {
    title: 'Wedding Save-the-Date Postcards',
    description: 'Printed directly on save-the-date stationery so guests can save the wedding weekend into their calendars 9 months in advance.',
    example: 'Couples sharing hotel block info, rehearsal dinner times, and reception addresses.'
  },
  {
    title: 'Formal Gala RSVP Response Cards',
    description: 'Placed alongside RSVP cards to ensure donors register the evening banquet into their digital calendars immediately upon receipt.',
    example: 'Non-profit foundation hosting an annual charity auction.'
  },
  {
    title: 'Milestone Celebration Invitations',
    description: '50th anniversary or retirement party invitations mailed to hundreds of family members across multiple cities.',
    example: 'Hosts eliminating duplicate reminder text messages by locking dates into phones.'
  },
  {
    title: 'Festival & Sports Pass Lanyards',
    description: 'Laminated VIP badge credentials featuring the weekend schedule breakdown.',
    example: 'Music festival attendees saving stage headliner set times with zero cellular data needed.'
  }
];

const tips = [
  'Match Paper Contrast: Ensure dark QR modules against a light background. Avoid metallic gold or foil on white paper, as low contrast prevents camera sensors from decoding.',
  'Keep Physical Size at Least 1 x 1 Inch: For wedding and formal stationery, maintain at least a 25mm x 25mm printed area with a clear quiet margin.',
  'Include Complete Venue Address: Enter the street address, suite/hall number, and city so calendar apps provide driving directions and arrival alerts.',
  'Double Check Time Zones: If hosting destination events, specify start times in the local destination time zone.',
  'Test on Coated and Matte Stock: Always run a physical sample print on your final paper stock before mass printing wedding or gala stationery.'
];

const technicalNotes = 'Stationery Standard: Generates standard vCalendar 2.0 / iCalendar RFC 5545 payloads. Completely offline and client-side; no RSVP or guest data is ever transmitted or stored on external servers.';

const faqs = [
  {
    question: 'How do guests add the event to their phones when scanning the stationery?',
    answer: 'When a guest opens their smartphone camera and points it at the printed invitation, an instant notification banner appears. Tapping it opens Apple Calendar (iPhone) or Google Calendar (Android) with all dates, times, venue location, and notes pre-filled for one-tap saving.'
  },
  {
    question: 'Does the Event QR code require cellular reception or internet to work?',
    answer: 'No! Because standard static vCalendar data is completely self-contained inside the QR code matrix itself, the guest’s phone can read and save the event details even in venues with zero cellular or Wi-Fi service.'
  },
  {
    question: 'Can I print this on textured or cotton paper for wedding invitations?',
    answer: 'Yes. However, ensure sufficient contrast between the ink color and paper. Dark charcoal, deep navy, burgundy, or black ink on white, cream, or ivory cotton paper scans reliably. Avoid pale pastels or foil stamping directly on the QR modules.'
  },
  {
    question: 'Can I add dress code notes or parking instructions?',
    answer: 'Yes. You can include concise notes in the Description field, such as "Black tie optional," "Valet parking available at North Entrance," or "Cocktail reception to follow."'
  },
  {
    question: 'Will this code work forever or does it have an expiration date?',
    answer: 'Static Event QR codes never expire. The calendar details are permanently encoded into the visual barcode pattern and will remain functional indefinitely.'
  },
  {
    question: 'Is any private event or guest information uploaded to your server?',
    answer: 'No. The QR code generation process executes entirely in your browser using client-side JavaScript. No celebration details, private addresses, or host names are ever transmitted to or stored on our servers.'
  }
];

const relatedTools = [
  { name: 'Event Calendar Generator', slug: 'event-qr-code-generator', description: 'Create general multi-platform calendar invite QR codes for conferences and webinars.' },
  { name: 'Location QR Generator', slug: 'location-qr-code-generator', description: 'Guide guests directly to your wedding or party venue entrance with GPS coordinates.' },
  { name: 'vCard QR Generator', slug: 'vcard-qr-code-generator', description: 'Share event planner or coordinator contact details on stationery.' },
  { name: 'Wi-Fi QR Code Generator', slug: 'wifi-qr-code-generator', description: 'Provide one-tap guest Wi-Fi access at your party or wedding reception.' }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title="Event QR Code for Invitations & RSVPs — Save-the-Date QR Code"
  description="Generate instant calendar invite QR codes for wedding invitations, RSVP cards, conference passes, and party stationery. Works with Apple & Google Calendar."
  jsonLd={faqJsonLd}
>
  <div class="bg-grid-subtle py-4 sm:py-6 border-b border-slate-200/80 dark:border-slate-800/80">
    <QRGenerator
      initialType="event"
      headline="Event QR Code for Invitations & RSVPs"
      subheadline="Let wedding guests, gala patrons, and party attendees save your dates, times, and venue locations directly into their phone calendar with a single scan."
    />
  </div>

  <LandingContent
    heading="Invitation & RSVP Event QR Code"
    subheading="Eliminate forgotten dates and manual phone entry on wedding stationery, party invitations, and event passes."
    overviewTitle={overviewTitle}
    overviewParagraphs={overviewParagraphs}
    sectors={sectors}
    howItWorks={howItWorks}
    useCases={useCases}
    tips={tips}
    technicalNotes={technicalNotes}
    faqs={faqs}
    relatedTools={relatedTools}
  />
</BaseLayout>
