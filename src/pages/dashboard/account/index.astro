---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login');
}

const db = getDb(Astro.locals);
const userRes = await db.prepare('SELECT id, email, name, role, plan, status, created_at FROM users WHERE id = ?').bind(user.id).all();
const profile = userRes.results?.[0] as any || user;

const joinDate = new Date(profile.created_at || Date.now()).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<DashboardLayout title="Account Settings" activeNav="account">
  <div class="space-y-6 max-w-2xl mx-auto">
    <!-- Header -->
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
        Account Settings
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Manage your personal profile and account credentials.
      </p>
    </div>

    <!-- Feedback Banner -->
    <div id="account-feedback" class="hidden p-3 rounded-2xl text-xs font-bold transition-all"></div>

    <!-- Profile Form -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
      <form id="account-form" class="space-y-4">
        <div>
          <label for="profile-name" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Display Name
          </label>
          <input
            type="text"
            id="profile-name"
            value={profile.name}
            required
            class="w-full px-4 py-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Email Address
          </label>
          <input
            type="email"
            value={profile.email}
            disabled
            class="w-full px-4 py-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 text-sm text-slate-500 cursor-not-allowed"
          />
          <p class="text-[11px] text-slate-400 mt-1">Email cannot be changed directly in this phase.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Current Plan
          </label>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 rounded-xl text-xs font-bold uppercase bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
              {profile.plan || 'Free'}
            </span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Member Since
          </label>
          <p class="text-xs text-slate-600 dark:text-slate-400">{joinDate}</p>
        </div>

        <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
          <button
            type="submit"
            id="save-account-btn"
            class="px-5 py-2.5 rounded-2xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all cursor-pointer"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  const form = document.getElementById('account-form') as HTMLFormElement;
  const nameInput = document.getElementById('profile-name') as HTMLInputElement;
  const feedback = document.getElementById('account-feedback');
  const saveBtn = document.getElementById('save-account-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!nameInput || !feedback || !saveBtn) return;

    saveBtn.disabled = true;
    saveBtn.innerText = 'Saving...';
    feedback.className = 'hidden';

    try {
      const res = await fetch('/api/user', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameInput.value.trim() }),
      });
      const data = await res.json();

      if (res.ok) {
        feedback.innerText = '✓ Display name updated successfully.';
        feedback.className = 'p-3 rounded-2xl text-xs font-bold bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300';
      } else {
        throw new Error(data.error?.message || 'Failed to update profile.');
      }
    } catch (err: any) {
      feedback.innerText = err?.message || 'Error updating profile.';
      feedback.className = 'p-3 rounded-2xl text-xs font-bold bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-300';
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerText = 'Save Changes';
    }
  });
</script>
