---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getUserEntitlements } from '../../../lib/billing/entitlements';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login');
}

const entitlements = await getUserEntitlements(user.id, Astro.locals);
const templateLimit = entitlements.templateLimit;

const db = getDb(Astro.locals);
const res = await db.prepare('SELECT * FROM templates WHERE user_id = ? ORDER BY created_at DESC').bind(user.id).all();
const templates = (res.results || []).map((t: any) => {
  let config = {};
  try {
    config = typeof t.style_config === 'string' ? JSON.parse(t.style_config) : (t.style_config || {});
  } catch {
    config = {};
  }
  return { ...t, style_config: config };
});
---

<DashboardLayout title="QR Design Templates" activeNav="qr">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-slate-400">
            {templates.length} / {templateLimit === null ? '∞' : templateLimit} Templates Used
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Saved Design Templates
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Save and reuse consistent branding, colors, frame styles, and module patterns across all your QR campaigns.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/dashboard/bulk"
          class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500 text-slate-800 dark:text-slate-200 shadow-sm transition-all"
        >
          Bulk Generator
        </a>
        <a
          href="/"
          class="px-5 py-2.5 rounded-2xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all"
        >
          + Create from Generator
        </a>
      </div>
    </div>

    <!-- Templates Grid -->
    {templates.length === 0 ? (
      <div class="p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">No saved templates yet</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Customize colors and module shapes in the QR generator, then click "Save as Template" to reuse the style anytime.
        </p>
        <a href="/" class="inline-block px-5 py-2.5 rounded-xl font-bold text-xs bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm">
          Open Generator
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {templates.map((tpl: any) => {
          const cfg = tpl.style_config;
          const fg = cfg.colors?.foreground || '#000000';
          const bg = cfg.colors?.isTransparent ? 'Transparent' : (cfg.colors?.background || '#ffffff');
          const createdDate = new Date(tpl.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

          return (
            <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-4 hover:border-indigo-500 transition-colors">
              <div class="space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-base font-bold text-slate-900 dark:text-white truncate">{tpl.name}</h3>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <span class="w-4 h-4 rounded-full border border-slate-300 shadow-xs" style={`background-color: ${fg};`} title={`Foreground: ${fg}`}></span>
                    <span class="w-4 h-4 rounded-full border border-slate-300 shadow-xs" style={`background-color: ${bg === 'Transparent' ? '#ffffff' : bg};`} title={`Background: ${bg}`}></span>
                  </div>
                </div>

                {tpl.description && (
                  <p class="text-xs text-slate-500 line-clamp-2">{tpl.description}</p>
                )}

                <div class="text-[11px] text-slate-400 space-y-1 pt-2 border-t border-slate-100 dark:border-slate-800">
                  <div>Dots: <span class="font-bold text-slate-700 dark:text-slate-300 capitalize">{cfg.dotType || 'square'}</span></div>
                  <div>Eyes: <span class="font-bold text-slate-700 dark:text-slate-300 capitalize">{cfg.eyeFrameType || 'square'}</span></div>
                  <div>Created: <span class="text-slate-500">{createdDate}</span></div>
                </div>
              </div>

              <div class="pt-2 flex items-center justify-between gap-2">
                <button
                  type="button"
                  class="duplicate-tpl-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
                  data-id={tpl.id}
                >
                  Duplicate
                </button>
                <button
                  type="button"
                  class="delete-tpl-btn px-3 py-1.5 rounded-xl text-xs font-bold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/60 cursor-pointer"
                  data-id={tpl.id}
                  data-name={tpl.name}
                >
                  Delete
                </button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  // Duplicate Template
  document.querySelectorAll('.duplicate-tpl-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      try {
        const res = await fetch(`/api/templates/${id}/duplicate`, { method: 'POST' });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to duplicate template.');
        }
      } catch {
        alert('Error duplicating template.');
      }
    });
  });

  // Delete Template
  document.querySelectorAll('.delete-tpl-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      if (!id || !confirm(`Delete template "${name}"?`)) return;
      try {
        const res = await fetch(`/api/templates/${id}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete template.');
        }
      } catch {
        alert('Error deleting template.');
      }
    });
  });
</script>
