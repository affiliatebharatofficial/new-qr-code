---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getCurrentUser } from '../../../../lib/auth/jwt';
import { getDb } from '../../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login');
}

const id = Astro.params.id;
const db = getDb(Astro.locals);

const qrRes = await db.prepare('SELECT * FROM qr_codes WHERE id = ?').bind(id).all();
const qr = qrRes.results?.[0] as any;

if (!qr) {
  return Astro.redirect('/dashboard/qr');
}

// Strict IDOR Protection
if (qr.user_id !== user.id && user.role !== 'admin') {
  return Astro.redirect('/dashboard/qr');
}

// Get scan count
const scansCountRes = await db.prepare('SELECT COUNT(*) as total FROM qr_scans WHERE qr_id = ?').bind(id).all();
const totalScans = (scansCountRes.results?.[0] as any)?.total || qr.scans_count || 0;

let styleConfig: any = {};
try {
  styleConfig = typeof qr.style_config === 'string' ? JSON.parse(qr.style_config) : (qr.style_config || {});
} catch {
  styleConfig = {};
}

const createdDate = new Date(qr.created_at).toLocaleString('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
const updatedDate = new Date(qr.updated_at).toLocaleString('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const shortUrl = qr.short_code ? `https://freeqrcode-generator.com/r/${qr.short_code}` : null;
---

<DashboardLayout title={`QR Details: ${qr.name}`} activeNav="qr">
  <div class="space-y-6 max-w-4xl mx-auto">
    
    <!-- Back Link & Header -->
    <div>
      <a href="/dashboard/qr" class="text-xs font-semibold text-slate-500 hover:text-indigo-600 flex items-center gap-1 mb-3">
        &larr; Back to My QR Codes
      </a>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
              {qr.type}
            </span>
            <span class={`px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase tracking-wider ${
              qr.is_dynamic ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'
            }`}>
              {qr.is_dynamic ? 'Dynamic QR' : 'Static QR'}
            </span>
            <span class={`px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase tracking-wider ${
              qr.status === 'active'
                ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800'
                : 'bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800'
            }`}>
              {qr.status}
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
            {qr.name}
          </h1>
          <p class="text-xs text-slate-500 mt-0.5">ID: {qr.id}</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          {qr.is_dynamic && (
            <a
              href={`/dashboard/qr/${qr.id}/analytics`}
              class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 transition-all"
            >
              📊 Scan Analytics ({totalScans})
            </a>
          )}

          <button
            type="button"
            id="open-edit-modal-btn"
            class="px-4 py-2.5 rounded-2xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>✏️</span> Edit Details
          </button>

          {qr.is_dynamic && (
            <button
              type="button"
              id="toggle-status-btn"
              data-id={qr.id}
              data-current-status={qr.status}
              class="px-3.5 py-2.5 rounded-2xl text-xs font-bold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer"
            >
              {qr.status === 'active' ? 'Pause QR' : 'Activate QR'}
            </button>
          )}

          <button
            type="button"
            id="duplicate-btn"
            data-id={qr.id}
            class="px-3.5 py-2.5 rounded-2xl text-xs font-bold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer"
          >
            Duplicate
          </button>
          <button
            type="button"
            id="delete-btn"
            data-id={qr.id}
            class="px-3.5 py-2.5 rounded-2xl text-xs font-bold bg-red-50 dark:bg-red-950/60 hover:bg-red-100 text-red-600 dark:text-red-400 transition-colors cursor-pointer"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Main QR Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      
      <!-- QR Preview Card (5 cols) -->
      <div class="md:col-span-5 p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4 text-center">
        <div class="relative aspect-square max-w-[280px] mx-auto rounded-2xl bg-white dark:bg-slate-950/80 border border-slate-100 dark:border-slate-800 flex items-center justify-center p-4">
          <div
            id="detail-qr-viewport"
            class="w-full h-full flex items-center justify-center overflow-hidden"
            data-payload={qr.payload}
            data-style={typeof qr.style_config === 'string' ? qr.style_config : JSON.stringify(qr.style_config || {})}
            data-name={qr.name}
            data-id={qr.id}
            data-dynamic={qr.is_dynamic ? 'true' : 'false'}
          ></div>
        </div>

        {shortUrl && (
          <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-left space-y-1">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Dynamic Redirect URL</div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-mono text-indigo-600 dark:text-indigo-400 truncate">{shortUrl}</span>
              <button
                type="button"
                id="copy-short-url"
                data-url={shortUrl}
                class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 cursor-pointer"
              >
                Copy
              </button>
            </div>
          </div>
        )}

        <!-- Download Buttons -->
        <div class="grid grid-cols-2 gap-2 pt-2">
          <button
            type="button"
            id="detail-dl-png"
            class="py-2.5 px-3 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm cursor-pointer"
          >
            Download PNG
          </button>
          <button
            type="button"
            id="detail-dl-svg"
            class="py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm cursor-pointer"
          >
            Download SVG
          </button>
        </div>
      </div>

      <!-- Information & Metadata (7 cols) -->
      <div class="md:col-span-7 space-y-6">
        {qr.is_dynamic && qr.destination && (
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">Target Destination URL</h2>
              <button type="button" class="trigger-edit-destination-btn text-xs font-bold text-indigo-600 hover:underline cursor-pointer">
                ✏️ Change Destination
              </button>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
              <a href={qr.destination} target="_blank" rel="noopener noreferrer" class="text-xs font-mono font-bold text-indigo-600 hover:underline break-all">
                {qr.destination} ↗
              </a>
            </div>
            <p class="text-[11px] text-slate-400">
              ✓ Updating destination preserves your printed QR barcode. Scans will instantly route to the new URL.
            </p>
          </div>
        )}

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">Encoded QR Payload</h2>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <pre class="text-xs font-mono text-slate-800 dark:text-slate-200 whitespace-pre-wrap break-all">{qr.payload}</pre>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">Configuration Details</h2>
          <dl class="grid grid-cols-2 gap-4 text-xs">
            <div>
              <dt class="text-slate-400">Type</dt>
              <dd class="font-bold text-slate-900 dark:text-white mt-0.5 uppercase">{qr.type}</dd>
            </div>
            <div>
              <dt class="text-slate-400">Total Scans</dt>
              <dd class="font-bold text-slate-900 dark:text-white mt-0.5">{qr.is_dynamic ? totalScans : '— (Static)'}</dd>
            </div>
            <div>
              <dt class="text-slate-400">Foreground Color</dt>
              <dd class="font-mono font-bold text-slate-900 dark:text-white mt-0.5">
                {styleConfig.colors?.foreground || '#000000'}
              </dd>
            </div>
            <div>
              <dt class="text-slate-400">Background Color</dt>
              <dd class="font-mono font-bold text-slate-900 dark:text-white mt-0.5">
                {styleConfig.colors?.isTransparent ? 'Transparent' : (styleConfig.colors?.background || '#ffffff')}
              </dd>
            </div>
            <div>
              <dt class="text-slate-400">Created Date</dt>
              <dd class="font-medium text-slate-700 dark:text-slate-300 mt-0.5">
                {createdDate}
              </dd>
            </div>
            <div>
              <dt class="text-slate-400">Last Modified</dt>
              <dd class="font-medium text-slate-700 dark:text-slate-300 mt-0.5">
                {updatedDate}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Edit QR Details & Destination -->
  <div id="edit-qr-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-6 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Edit QR Code</h3>
          <p class="text-xs text-slate-500 mt-0.5">Update details or change target destination URL.</p>
        </div>
        <button type="button" id="btn-close-edit-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg cursor-pointer">✕</button>
      </div>

      <div id="edit-modal-error" class="hidden p-3 rounded-xl text-xs bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-300 border border-red-200 dark:border-red-800"></div>

      <form id="edit-qr-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            QR Code Name
          </label>
          <input
            type="text"
            id="edit-name-input"
            required
            value={qr.name}
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>

        {qr.is_dynamic ? (
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Destination URL (Dynamic Target)
            </label>
            <input
              type="url"
              id="edit-destination-input"
              required
              value={qr.destination || ''}
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none"
              placeholder="https://yourwebsite.com/new-page"
            />
            <p class="text-[11px] text-slate-500 mt-1">
              Redirect destination can be updated at any time without changing the printed QR image.
            </p>
          </div>
        ) : (
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Static QR Raw Payload
            </label>
            <textarea
              id="edit-payload-input"
              rows={3}
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >{qr.payload}</textarea>
            <p class="text-[11px] text-amber-600 dark:text-amber-400 mt-1">
              ⚠️ Note: Changing a Static QR payload alters its visual barcode pattern.
            </p>
          </div>
        )}

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Status
          </label>
          <select
            id="edit-status-select"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-xs font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          >
            <option value="active" selected={qr.status === 'active'}>Active (Scans routed)</option>
            <option value="paused" selected={qr.status !== 'active'}>Paused (Disabled)</option>
          </select>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-edit-modal"
            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="btn-save-qr-edit"
            class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm cursor-pointer"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

</DashboardLayout>

<!-- Client QR Renderer Script -->
<script>
  import QRCodeStyling from 'qr-code-styling';

  let qrCodeInstance: any = null;

  function initQR() {
    const viewport = document.getElementById('detail-qr-viewport');
    if (!viewport) return;

    const payload = viewport.getAttribute('data-payload') || '';
    let styleConfig: any = {};
    try {
      styleConfig = JSON.parse(viewport.getAttribute('data-style') || '{}');
    } catch {
      styleConfig = {};
    }

    const dotsColor = styleConfig.colors?.foreground || '#000000';
    const bgColor = styleConfig.colors?.isTransparent ? 'transparent' : (styleConfig.colors?.background || '#ffffff');

    const qrOptions: any = {
      width: 256,
      height: 256,
      type: 'canvas',
      data: payload || 'https://freeqrcode-generator.com',
      margin: typeof styleConfig.margin === 'number' ? styleConfig.margin : 10,
      qrOptions: {
        errorCorrectionLevel: styleConfig.errorCorrection || 'M',
      },
      dotsOptions: {
        color: dotsColor,
        type: styleConfig.dotType || 'square',
      },
      backgroundOptions: {
        color: bgColor,
      },
      cornersSquareOptions: {
        type: styleConfig.eyeFrameType || 'square',
        color: dotsColor,
      },
      cornersDotOptions: {
        type: styleConfig.eyeDotType || 'square',
        color: dotsColor,
      },
    };

    if (styleConfig.logo?.src) {
      qrOptions.image = styleConfig.logo.src;
      qrOptions.imageOptions = {
        hideBackgroundDots: styleConfig.logo.hideBackgroundDots ?? true,
        imageSize: styleConfig.logo.sizeRatio || 0.25,
        margin: styleConfig.logo.margin || 4,
        crossOrigin: 'anonymous',
      };
    }

    try {
      qrCodeInstance = new QRCodeStyling(qrOptions);
      viewport.innerHTML = '';
      qrCodeInstance.append(viewport);
    } catch (e) {
      console.error('Failed to render QR Code:', e);
    }
  }

  function setupActions() {
    const viewport = document.getElementById('detail-qr-viewport');
    if (!viewport) return;

    const qrName = viewport.getAttribute('data-name') || 'qrcode';
    const qrId = viewport.getAttribute('data-id') || '';
    const cleanName = qrName.replace(/[^a-zA-Z0-9_-]/g, '_') || 'qrcode';
    const isDynamic = viewport.getAttribute('data-dynamic') === 'true';

    document.getElementById('detail-dl-png')?.addEventListener('click', () => {
      qrCodeInstance?.download({ name: `${cleanName}.png`, extension: 'png' });
    });

    document.getElementById('detail-dl-svg')?.addEventListener('click', () => {
      qrCodeInstance?.download({ name: `${cleanName}.svg`, extension: 'svg' });
    });

    document.getElementById('copy-short-url')?.addEventListener('click', async (e: any) => {
      const url = e.currentTarget?.getAttribute('data-url');
      if (!url) return;
      await navigator.clipboard.writeText(url);
      e.currentTarget.innerText = 'Copied!';
      setTimeout(() => (e.currentTarget.innerText = 'Copy'), 2000);
    });

    document.getElementById('toggle-status-btn')?.addEventListener('click', async (e: any) => {
      const current = e.currentTarget?.getAttribute('data-current-status');
      const endpoint = current === 'active' ? `/api/qr/${qrId}/pause` : `/api/qr/${qrId}/activate`;
      const res = await fetch(endpoint, { method: 'POST' });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to update status.');
      }
    });

    document.getElementById('duplicate-btn')?.addEventListener('click', async (e: any) => {
      const id = e.currentTarget?.getAttribute('data-id');
      if (!id) return;
      const res = await fetch(`/api/qr/${id}/duplicate`, { method: 'POST' });
      if (res.ok) {
        window.location.href = '/dashboard/qr';
      } else {
        alert('Failed to duplicate.');
      }
    });

    document.getElementById('delete-btn')?.addEventListener('click', async (e: any) => {
      const id = e.currentTarget?.getAttribute('data-id');
      if (!id || !confirm(`Are you sure you want to delete "${qrName}"?`)) return;
      const res = await fetch(`/api/qr/${id}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = '/dashboard/qr';
      } else {
        alert('Failed to delete.');
      }
    });

    const editModal = document.getElementById('edit-qr-modal');
    const openEditBtn = document.getElementById('open-edit-modal-btn');
    const closeEditBtn = document.getElementById('btn-close-edit-modal');
    const cancelEditBtn = document.getElementById('btn-cancel-edit-modal');
    const editForm = document.getElementById('edit-qr-form');
    const editError = document.getElementById('edit-modal-error');
    const saveBtn = document.getElementById('btn-save-qr-edit') as HTMLButtonElement | null;

    const openModal = () => {
      editModal?.classList.remove('hidden');
      editModal?.classList.add('flex');
    };

    const closeModal = () => {
      editModal?.classList.add('hidden');
      editModal?.classList.remove('flex');
      if (editError) editError.classList.add('hidden');
    };

    openEditBtn?.addEventListener('click', openModal);
    document.querySelectorAll('.trigger-edit-destination-btn').forEach((btn) => btn.addEventListener('click', openModal));
    closeEditBtn?.addEventListener('click', closeModal);
    cancelEditBtn?.addEventListener('click', closeModal);

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!saveBtn) return;

      const name = (document.getElementById('edit-name-input') as HTMLInputElement)?.value;
      const status = (document.getElementById('edit-status-select') as HTMLSelectElement)?.value;
      
      const updateData: Record<string, any> = { name, status };

      if (isDynamic) {
        const destination = (document.getElementById('edit-destination-input') as HTMLInputElement)?.value;
        updateData.destination = destination;
      } else {
        const payloadVal = (document.getElementById('edit-payload-input') as HTMLTextAreaElement)?.value;
        updateData.payload = payloadVal;
      }

      saveBtn.disabled = true;
      saveBtn.innerText = 'Saving...';

      try {
        const res = await fetch(`/api/qr/${qrId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updateData),
        });

        const json = await res.json();
        if (!res.ok) {
          throw new Error(json.error?.message || 'Failed to update QR code.');
        }

        window.location.reload();
      } catch (err: any) {
        if (editError) {
          editError.innerText = err.message || 'An error occurred.';
          editError.classList.remove('hidden');
        }
        saveBtn.disabled = false;
        saveBtn.innerText = 'Save Changes';
      }
    });
  }

  initQR();
  setupActions();
  document.addEventListener('astro:page-load', () => {
    initQR();
    setupActions();
  });
</script>
