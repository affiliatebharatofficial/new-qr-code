---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import { getCurrentUser } from '../../../../../lib/auth/jwt';
import { getDb } from '../../../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login');
}

const id = Astro.params.id;
const db = getDb(Astro.locals);

// Fetch QR details
const qrRes = await db.prepare('SELECT * FROM qr_codes WHERE id = ?').bind(id).all();
const qr = qrRes.results?.[0] as any;

if (!qr) {
  return Astro.redirect('/dashboard/qr');
}

// Strict IDOR Verification
if (qr.user_id !== user.id && user.role !== 'admin') {
  return Astro.redirect('/dashboard/qr');
}

const url = new URL(Astro.request.url);
const range = url.searchParams.get('range') || '30d';

const now = Date.now();
let periodMs = 30 * 24 * 60 * 60 * 1000;
let periodLabel = 'Last 30 Days';
let timelineBuckets = 14;

if (range === 'today') {
  periodMs = 24 * 60 * 60 * 1000;
  periodLabel = 'Today (24h)';
  timelineBuckets = 24;
} else if (range === '7d') {
  periodMs = 7 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 7 Days';
  timelineBuckets = 7;
} else if (range === '90d') {
  periodMs = 90 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 90 Days';
  timelineBuckets = 12;
} else if (range === '12m') {
  periodMs = 365 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 12 Months';
  timelineBuckets = 12;
}

const currentPeriodStart = now - periodMs;
const prevPeriodStart = currentPeriodStart - periodMs;

// Fetch Scans for this QR
const [scansRes, prevScansRes] = await Promise.all([
  db.prepare('SELECT * FROM qr_scans WHERE qr_id = ? AND scanned_at >= ? ORDER BY scanned_at DESC').bind(id, currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM qr_scans WHERE qr_id = ? AND scanned_at >= ? AND scanned_at < ?').bind(id, prevPeriodStart, currentPeriodStart).all(),
]);

const scans = scansRes.results || [];
const prevCount = (prevScansRes.results?.[0] as any)?.count || 0;
const currentCount = scans.length;

let todayCount = 0;
let weekCount = 0;
const uniqueIps = new Set<string>();

const devicesMap: Record<string, number> = {};
const countriesMap: Record<string, number> = {};
const browsersMap: Record<string, number> = {};
const osMap: Record<string, number> = {};
const referrerMap: Record<string, number> = {};
const timeOfDayMap: Record<string, number> = {
  'Night (12am-6am)': 0,
  'Morning (6am-12pm)': 0,
  'Afternoon (12pm-6pm)': 0,
  'Evening (6pm-12am)': 0,
};
const dayOfWeekMap: Record<string, number> = {
  'Mon': 0, 'Tue': 0, 'Wed': 0, 'Thu': 0, 'Fri': 0, 'Sat': 0, 'Sun': 0
};
const daysArr = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

// Build timeline buckets
const timelineMap: Record<string, { label: string; count: number }> = {};
const bucketDays = Math.max(1, Math.round(periodMs / (timelineBuckets * 24 * 60 * 60 * 1000)));

for (let i = timelineBuckets - 1; i >= 0; i--) {
  const d = new Date(now - i * bucketDays * 24 * 60 * 60 * 1000);
  const key = d.toISOString().split('T')[0];
  const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  timelineMap[key] = { label, count: 0 };
}

const oneDayAgo = now - 24 * 60 * 60 * 1000;
const sevenDaysAgo = now - 7 * 24 * 60 * 60 * 1000;

for (const s of scans as any[]) {
  if (s.ip_hash) uniqueIps.add(s.ip_hash);
  if (s.scanned_at >= oneDayAgo) todayCount++;
  if (s.scanned_at >= sevenDaysAgo) weekCount++;

  const dObj = new Date(s.scanned_at);
  const dateKey = dObj.toISOString().split('T')[0];
  if (timelineMap[dateKey]) {
    timelineMap[dateKey].count++;
  }

  const dev = s.device_type || 'Mobile';
  devicesMap[dev] = (devicesMap[dev] || 0) + 1;

  const c = s.country || 'Unknown';
  countriesMap[c] = (countriesMap[c] || 0) + 1;

  const b = s.browser || 'Unknown';
  browsersMap[b] = (browsersMap[b] || 0) + 1;

  const o = s.os || 'Unknown';
  osMap[o] = (osMap[o] || 0) + 1;

  const r = s.referrer || 'Direct Scan';
  referrerMap[r] = (referrerMap[r] || 0) + 1;

  const hour = dObj.getHours();
  if (hour < 6) timeOfDayMap['Night (12am-6am)']++;
  else if (hour < 12) timeOfDayMap['Morning (6am-12pm)']++;
  else if (hour < 18) timeOfDayMap['Afternoon (12pm-6pm)']++;
  else timeOfDayMap['Evening (6pm-12am)']++;

  const dayName = daysArr[dObj.getDay()];
  if (dayOfWeekMap[dayName] !== undefined) {
    dayOfWeekMap[dayName]++;
  }
}

const timeline = Object.values(timelineMap);
const maxDailyCount = Math.max(...timeline.map((t) => t.count), 1);

const topCountries = Object.entries(countriesMap).sort((a, b) => b[1] - a[1]).slice(0, 5);
const topDevices = Object.entries(devicesMap).sort((a, b) => b[1] - a[1]);
const topBrowsers = Object.entries(browsersMap).sort((a, b) => b[1] - a[1]).slice(0, 5);
const topOs = Object.entries(osMap).sort((a, b) => b[1] - a[1]).slice(0, 5);

let growthPctStr = '0%';
if (prevCount === 0) {
  growthPctStr = currentCount > 0 ? '+100%' : '0%';
} else {
  const pct = Math.round(((currentCount - prevCount) / prevCount) * 100);
  growthPctStr = pct >= 0 ? `+${pct}%` : `${pct}%`;
}

const shortUrl = qr.short_code ? `https://freeqrcode-generator.com/r/${qr.short_code}` : null;
---

<DashboardLayout title={`Analytics: ${qr.name}`} activeNav="qr">
  <div class="space-y-8 max-w-5xl mx-auto">
    
    <!-- Top Header & Breadcrumb -->
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
        <a href="/dashboard/qr" class="hover:text-indigo-600 hover:underline">&larr; Back to My QR Codes</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{qr.name}</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class={`px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase tracking-wider ${
              qr.is_dynamic 
                ? 'bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
            }`}>
              {qr.is_dynamic ? 'Dynamic Campaign' : 'Static QR Code'}
            </span>
            <span class="text-xs text-slate-400 font-mono">ID: {qr.id}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
            {qr.name}
          </h1>
          {shortUrl && (
            <p class="text-xs text-slate-500 font-mono mt-0.5">
              Live Edge Route: <a href={shortUrl} target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline">{shortUrl} ↗</a>
            </p>
          )}
        </div>

        <!-- Date Range Filter Selector -->
        {qr.is_dynamic ? (
          <div class="flex flex-wrap items-center gap-1.5 bg-white dark:bg-slate-900 p-1.5 rounded-xl border border-slate-200 dark:border-slate-800 text-xs shadow-card">
            <a
              href={`/dashboard/qr/${qr.id}/analytics?range=today`}
              class={`px-3 py-1.5 rounded-lg font-bold transition-colors ${range === 'today' ? 'bg-indigo-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:text-indigo-600'}`}
            >
              Today
            </a>
            <a
              href={`/dashboard/qr/${qr.id}/analytics?range=7d`}
              class={`px-3 py-1.5 rounded-lg font-bold transition-colors ${range === '7d' ? 'bg-indigo-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:text-indigo-600'}`}
            >
              7 Days
            </a>
            <a
              href={`/dashboard/qr/${qr.id}/analytics?range=30d`}
              class={`px-3 py-1.5 rounded-lg font-bold transition-colors ${range === '30d' ? 'bg-indigo-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:text-indigo-600'}`}
            >
              30 Days
            </a>
            <a
              href={`/dashboard/qr/${qr.id}/analytics?range=12m`}
              class={`px-3 py-1.5 rounded-lg font-bold transition-colors ${range === '12m' ? 'bg-indigo-600 text-white' : 'text-slate-600 dark:text-slate-400 hover:text-indigo-600'}`}
            >
              12 Months
            </a>
          </div>
        ) : null}
      </div>
    </div>

    <!-- Static QR Notice (if applicable) -->
    {!qr.is_dynamic ? (
      <div class="p-6 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/50 space-y-3">
        <div class="flex items-center gap-2 text-amber-800 dark:text-amber-300 font-bold text-sm">
          <span>ℹ️</span> Static QR Code — Real-Time Scan Tracking Unavailable
        </div>
        <p class="text-xs text-amber-700 dark:text-amber-400 leading-relaxed">
          This is an offline Static QR code. The payload data is directly encoded into the barcode modules and connects directly without passing through an edge redirection server. To track lifetime scan volume, countries, devices, and engagement times, convert or create a <strong>Dynamic QR Code</strong>.
        </p>
        <div class="pt-1">
          <a
            href="/"
            class="inline-block px-4 py-2 rounded-lg text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition-colors"
          >
            Create Dynamic QR Campaign &rarr;
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- 4 Primary KPI Summary Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Period Scans ({periodLabel})</span>
            <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">{currentCount}</div>
            <p class={`text-[11px] font-bold ${growthPctStr.startsWith('+') ? 'text-emerald-600' : 'text-slate-400'}`}>
              {growthPctStr} vs prev period
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Unique Daily Hashes</span>
            <div class="text-2xl sm:text-3xl font-black text-indigo-600 dark:text-indigo-400">{uniqueIps.size}</div>
            <p class="text-[11px] text-slate-400 font-mono">anonymized salted IP</p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Scans Today</span>
            <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">{todayCount}</div>
            <p class="text-[11px] text-slate-400 font-mono">{weekCount} this week</p>
          </div>

          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Lifetime Total</span>
            <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">{qr.scans_count || 0}</div>
            <p class="text-[11px] text-slate-400 font-mono">since creation</p>
          </div>
        </div>

        <!-- Scan Growth Graph -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-card space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📈</span> Scan Trajectory ({periodLabel})
            </h2>
            <span class="text-xs text-slate-400 font-mono">Total in window: {currentCount} scans</span>
          </div>

          {currentCount === 0 ? (
            <div class="text-center py-12 text-xs text-slate-500">
              No scans recorded for this QR code during this time window.
            </div>
          ) : (
            <div class="pt-4">
              <div class="h-44 flex items-end gap-2 sm:gap-3 border-b border-slate-100 dark:border-slate-800 pb-2">
                {timeline.map((point) => {
                  const heightPercent = Math.max(8, Math.round((point.count / maxDailyCount) * 100));
                  return (
                    <div class="flex-1 flex flex-col items-center gap-1 group relative h-full justify-end">
                      <div class="absolute -top-8 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-900 text-white text-[10px] py-1 px-2 rounded font-mono pointer-events-none whitespace-nowrap z-20 shadow-lg">
                        {point.count} scans ({point.label})
                      </div>
                      <div
                        class="w-full rounded-t-md bg-indigo-500 hover:bg-indigo-600 transition-all cursor-pointer"
                        style={`height: ${heightPercent}%;`}
                      ></div>
                      <span class="text-[9px] text-slate-400 font-mono hidden sm:block truncate w-full text-center">
                        {point.label}
                      </span>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>

        <!-- Breakdown Grid: Device, Country, OS, Browser -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Device -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Device Platform</h3>
            {topDevices.length === 0 ? (
              <p class="text-xs text-slate-400 py-3 text-center">No device data.</p>
            ) : (
              <div class="space-y-2 text-xs">
                {topDevices.map(([dev, count]) => (
                  <div class="flex justify-between">
                    <span class="capitalize font-semibold text-slate-700 dark:text-slate-300">{dev}</span>
                    <span class="font-mono text-indigo-600 dark:text-indigo-400 font-bold">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Country -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Top Countries</h3>
            {topCountries.length === 0 ? (
              <p class="text-xs text-slate-400 py-3 text-center">No country data.</p>
            ) : (
              <div class="space-y-2 text-xs">
                {topCountries.map(([c, count]) => (
                  <div class="flex justify-between">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{c}</span>
                    <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- OS -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Operating System</h3>
            {topOs.length === 0 ? (
              <p class="text-xs text-slate-400 py-3 text-center">No OS data.</p>
            ) : (
              <div class="space-y-2 text-xs">
                {topOs.map(([os, count]) => (
                  <div class="flex justify-between">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{os}</span>
                    <span class="font-mono text-purple-600 dark:text-purple-400 font-bold">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Browser -->
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-card space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Browser Client</h3>
            {topBrowsers.length === 0 ? (
              <p class="text-xs text-slate-400 py-3 text-center">No browser data.</p>
            ) : (
              <div class="space-y-2 text-xs">
                {topBrowsers.map(([b, count]) => (
                  <div class="flex justify-between">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{b}</span>
                    <span class="font-mono text-slate-600 dark:text-slate-300 font-bold">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

        </div>
      </>
    )}

  </div>
</DashboardLayout>
