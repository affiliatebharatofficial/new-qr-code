---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q')?.trim() || '';
const typeFilter = url.searchParams.get('type')?.trim() || '';

const db = getDb(Astro.locals);

let query = 'SELECT * FROM qr_codes WHERE user_id = ?';
const params: any[] = [user.id];

if (typeFilter) {
  query += ' AND type = ?';
  params.push(typeFilter);
}

if (search) {
  query += ' AND (LOWER(name) LIKE ? OR LOWER(payload) LIKE ?)';
  params.push(`%${search.toLowerCase()}%`, `%${search.toLowerCase()}%`);
}

query += ' ORDER BY created_at DESC LIMIT 100';

const res = await db.prepare(query).bind(...params).all();
const qrCodes = res.results || [];
---

<DashboardLayout title="My Saved QR Codes" activeNav="qr">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          My Saved QR Codes
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Search, edit, track scans, export data, duplicate, download, or manage your QR campaigns.
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a
          href="/api/qr/export?format=csv"
          class="px-3.5 py-2 rounded-2xl text-xs font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500 text-slate-700 dark:text-slate-300 shadow-sm"
        >
          Export CSV 📥
        </a>
        <a
          href="/dashboard/bulk"
          class="px-3.5 py-2 rounded-2xl text-xs font-bold bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 hover:bg-purple-100 text-purple-600 dark:text-purple-400"
        >
          Bulk Generator
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-2xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/20 transition-all cursor-pointer"
        >
          + New QR
        </a>
      </div>
    </div>

    <!-- Bulk Action Toolbar (Appears when items are checked) -->
    <div id="bulk-toolbar" class="hidden p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300">
          <span id="selected-count">0</span> items selected
        </span>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="bulk-download-zip-btn"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm cursor-pointer"
        >
          Download ZIP 📦
        </button>
        <button
          type="button"
          id="bulk-delete-selected-btn"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-red-600 hover:bg-red-700 text-white shadow-sm cursor-pointer"
        >
          Delete Selected
        </button>
      </div>
    </div>

    <!-- Filters & Search Bar -->
    <form method="GET" class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <input
          type="text"
          name="q"
          value={search}
          placeholder="Search by name or content..."
          class="w-full pl-10 pr-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 shadow-sm"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <select
        name="type"
        onchange="this.form.submit()"
        class="px-4 py-2.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 focus:ring-2 focus:ring-indigo-500 shadow-sm cursor-pointer"
      >
        <option value="">All Types</option>
        <option value="url" selected={typeFilter === 'url'}>Website URL</option>
        <option value="wifi" selected={typeFilter === 'wifi'}>Wi-Fi Network</option>
        <option value="vcard" selected={typeFilter === 'vcard'}>vCard Contact</option>
        <option value="whatsapp" selected={typeFilter === 'whatsapp'}>WhatsApp</option>
        <option value="upi" selected={typeFilter === 'upi'}>UPI Payment</option>
        <option value="email" selected={typeFilter === 'email'}>Email</option>
        <option value="phone" selected={typeFilter === 'phone'}>Phone</option>
        <option value="sms" selected={typeFilter === 'sms'}>SMS</option>
        <option value="text" selected={typeFilter === 'text'}>Plain Text</option>
        <option value="location" selected={typeFilter === 'location'}>Location</option>
        <option value="social" selected={typeFilter === 'social'}>Social</option>
      </select>

      {search && (
        <a href="/dashboard/qr" class="px-4 py-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800 text-xs font-bold text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200">
          Clear
        </a>
      )}
    </form>

    <!-- Table Content -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
      {qrCodes.length === 0 ? (
        <div class="text-center py-16 px-4 space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto text-slate-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">No QR codes found</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            {search || typeFilter ? 'Try clearing your search filters.' : 'Create and save your first QR code to view it here.'}
          </p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-slate-400 uppercase tracking-wider font-bold">
              <tr>
                <th class="py-3.5 px-4 w-10">
                  <input type="checkbox" id="select-all-qrs" class="rounded text-indigo-600 focus:ring-indigo-500" />
                </th>
                <th class="py-3.5 px-6">Name</th>
                <th class="py-3.5 px-6">Type &amp; Mode</th>
                <th class="py-3.5 px-6">Status</th>
                <th class="py-3.5 px-6">Scans</th>
                <th class="py-3.5 px-6">Created</th>
                <th class="py-3.5 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {qrCodes.map((qr: any) => {
                const dateStr = new Date(qr.created_at).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                });
                return (
                  <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors group">
                    <td class="py-4 px-4">
                      <input
                        type="checkbox"
                        class="qr-row-checkbox rounded text-indigo-600 focus:ring-indigo-500"
                        data-id={qr.id}
                        data-name={qr.name}
                        data-payload={qr.payload}
                      />
                    </td>
                    <td class="py-4 px-6 font-bold text-slate-900 dark:text-white">
                      <a href={`/dashboard/qr/${qr.id}`} class="hover:text-indigo-600 transition-colors">
                        {qr.name}
                      </a>
                      <div class="text-[11px] font-normal text-slate-400 max-w-xs truncate mt-0.5">
                        {qr.payload}
                      </div>
                    </td>
                    <td class="py-4 px-6">
                      <div class="flex items-center gap-1.5">
                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/60">
                          {qr.type}
                        </span>
                        <span class={`px-1.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider ${
                          qr.is_dynamic ? 'bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400' : 'bg-slate-100 dark:bg-slate-800 text-slate-500'
                        }`}>
                          {qr.is_dynamic ? 'Dynamic' : 'Static'}
                        </span>
                      </div>
                    </td>
                    <td class="py-4 px-6">
                      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase tracking-wider ${
                        qr.status === 'active'
                          ? 'bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400'
                          : 'bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400'
                      }`}>
                        <span class={`w-1.5 h-1.5 rounded-full ${qr.status === 'active' ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                        {qr.status}
                      </span>
                    </td>
                    <td class="py-4 px-6 font-bold text-slate-700 dark:text-slate-300">
                      {qr.is_dynamic ? (
                        <a href={`/dashboard/qr/${qr.id}/analytics`} class="hover:text-indigo-600 underline decoration-dotted">
                          {qr.scans_count || 0}
                        </a>
                      ) : (
                        <span class="text-slate-400 font-normal">—</span>
                      )}
                    </td>
                    <td class="py-4 px-6 text-slate-400">
                      {dateStr}
                    </td>
                    <td class="py-4 px-6 text-right space-x-1.5 whitespace-nowrap">
                      {qr.is_dynamic && (
                        <a
                          href={`/dashboard/qr/${qr.id}/analytics`}
                          class="inline-block p-1.5 rounded-lg text-purple-600 dark:text-purple-400 hover:bg-purple-50 dark:hover:bg-purple-950/60 font-semibold"
                          title="Scan Analytics"
                        >
                          Analytics
                        </a>
                      )}
                      <a
                        href={`/dashboard/qr/${qr.id}`}
                        class="inline-block p-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold"
                        title="View Details"
                      >
                        View
                      </a>
                      <a
                        href={`/?edit=${qr.id}`}
                        class="inline-block p-1.5 rounded-lg text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/60 font-semibold"
                        title="Edit Configuration"
                      >
                        Edit
                      </a>
                      <button
                        type="button"
                        class="duplicate-qr-btn inline-block p-1.5 rounded-lg text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/60 font-semibold cursor-pointer"
                        data-id={qr.id}
                        title="Duplicate"
                      >
                        Duplicate
                      </button>
                      <button
                        type="button"
                        class="delete-qr-btn inline-block p-1.5 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/60 font-semibold cursor-pointer"
                        data-id={qr.id}
                        data-name={qr.name}
                        title="Delete"
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>

<script>
  const selectAll = document.getElementById('select-all-qrs') as HTMLInputElement;
  const checkboxes = document.querySelectorAll('.qr-row-checkbox') as NodeListOf<HTMLInputElement>;
  const toolbar = document.getElementById('bulk-toolbar');
  const countLabel = document.getElementById('selected-count');

  function updateBulkToolbar() {
    const checked = Array.from(checkboxes).filter((c) => c.checked);
    if (countLabel) countLabel.innerText = String(checked.length);
    if (checked.length > 0) {
      toolbar?.classList.remove('hidden');
      toolbar?.classList.add('flex');
    } else {
      toolbar?.classList.add('hidden');
      toolbar?.classList.remove('flex');
    }
  }

  selectAll?.addEventListener('change', () => {
    checkboxes.forEach((cb) => (cb.checked = selectAll.checked));
    updateBulkToolbar();
  });

  checkboxes.forEach((cb) => cb.addEventListener('change', updateBulkToolbar));

  // Bulk Delete
  document.getElementById('bulk-delete-selected-btn')?.addEventListener('click', async () => {
    const checked = Array.from(checkboxes).filter((c) => c.checked);
    const ids = checked.map((c) => c.getAttribute('data-id')).filter(Boolean);
    if (ids.length === 0) return;

    if (!confirm(`Are you sure you want to permanently delete ${ids.length} selected QR codes?`)) return;

    try {
      const res = await fetch('/api/qr/bulk-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to delete selected QR codes.');
      }
    } catch {
      alert('Error during bulk deletion.');
    }
  });

  // Bulk Download Selected as ZIP
  document.getElementById('bulk-download-zip-btn')?.addEventListener('click', async () => {
    const checked = Array.from(checkboxes).filter((c) => c.checked);
    if (checked.length === 0) return;

    const JSZipModule = await import('jszip');
    const JSZip = JSZipModule.default;
    const qrModule = await import('qr-code-styling');
    const QRCodeStyling = qrModule.default;

    const zip = new JSZip();

    for (let i = 0; i < checked.length; i++) {
      const cb = checked[i];
      const name = cb.getAttribute('data-name') || `qr_${i + 1}`;
      const payload = cb.getAttribute('data-payload') || 'https://example.com';
      const cleanName = name.replace(/[^a-zA-Z0-9_-]/g, '_');

      const qr = new QRCodeStyling({
        width: 512,
        height: 512,
        data: payload,
      });

      const blob = await qr.getRawData('png');
      if (blob) {
        zip.file(`${cleanName}.png`, blob);
      }
    }

    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(zipBlob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `selected-qr-codes-${Date.now()}.zip`;
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
