---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { LOCALES } from '../../../lib/i18n/config';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/content');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const languages = [
  { code: 'en', name: 'English', native: 'English', flag: '🇺🇸', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'es', name: 'Spanish', native: 'Español', flag: '🇪🇸', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'de', name: 'German', native: 'Deutsch', flag: '🇩🇪', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'fr', name: 'French', native: 'Français', flag: '🇫🇷', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'pt', name: 'Portuguese', native: 'Português', flag: '🇧🇷', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'it', name: 'Italian', native: 'Italiano', flag: '🇮🇹', status: 'Complete (100%)', strings: 420, missing: 0 },
  { code: 'hi', name: 'Hindi', native: 'हिन्दी', flag: '🇮🇳', status: 'Complete (100%)', strings: 420, missing: 0 },
];
---

<AdminLayout title="CMS & Multilingual Manager" activeNav="content">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">CMS & Multilingual Localization</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Manage global language translations, copy synchronization, and structured content modules.</p>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin/content/faqs" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm transition-colors flex items-center gap-1.5">
          <span>❓</span> Manage FAQ Knowledge Base
        </a>
      </div>
    </div>

    <!-- Multilingual Status Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {languages.map((lang) => (
        <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4 hover:border-slate-700 transition-colors">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="text-2xl">{lang.flag}</span>
              <div>
                <h3 class="text-sm font-bold text-white">{lang.name}</h3>
                <span class="text-[11px] text-slate-500 font-mono">{lang.native} ({lang.code.toUpperCase()})</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-950/60 text-emerald-400 border border-emerald-800">
              {lang.status}
            </span>
          </div>

          <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1.5 text-xs text-slate-300 font-mono">
            <div class="flex justify-between">
              <span class="text-slate-400">Total UI Strings:</span>
              <span class="font-bold text-white">{lang.strings}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Missing Translation Keys:</span>
              <span class="font-bold text-emerald-400">0 (Zero)</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Public Route:</span>
              <span class="font-bold text-indigo-400">/{lang.code === 'en' ? '' : lang.code}</span>
            </div>
          </div>

          <div class="pt-2 flex items-center justify-between text-xs">
            <a href={`/${lang.code === 'en' ? '' : lang.code}`} target="_blank" class="text-slate-400 hover:text-white underline">
              Preview Landing ↗
            </a>
            <span class="text-[11px] text-emerald-400 font-semibold">100% Live ✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</AdminLayout>
