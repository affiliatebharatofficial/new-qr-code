---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../../lib/auth/jwt';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/content/faqs');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// Structured Master FAQ Knowledge Base
const faqs = [
  {
    id: 'faq_1',
    category: 'General & Pricing',
    question: 'Are the QR codes generated on this website 100% free with no expiration?',
    answer: 'Yes! All static QR codes (including Website URLs, Wi-Fi networks, vCard contacts, plain text, and WhatsApp messages) generated on freeqrcode-generator.com are completely free for both personal and commercial use with lifetime validity.',
    status: 'published',
    routes: ['/', '/es', '/de', '/fr', '/pt', '/it', '/hi', '/pricing'],
  },
  {
    id: 'faq_2',
    category: 'Technical & Formats',
    question: 'What is the difference between Static and Dynamic QR codes?',
    answer: 'Static QR codes encode the destination payload directly into the pattern modules and cannot be changed once printed. Dynamic QR codes route through a lightweight edge short link, allowing you to edit the destination URL at any time and track scan analytics.',
    status: 'published',
    routes: ['/', '/pricing', '/dashboard/qr'],
  },
  {
    id: 'faq_3',
    category: 'Commercial & Vector',
    question: 'Can I download vector SVG format for high-resolution packaging and billboard printing?',
    answer: 'Yes. Our platform provides high-precision SVG vector exports alongside high-resolution PNGs at 2000x2000 px, ensuring crystal-clear optical scannability across large physical print mediums.',
    status: 'published',
    routes: ['/', '/url-to-qr-code', '/restaurant-menu-qr-code'],
  },
  {
    id: 'faq_4',
    category: 'Payments & Security',
    question: 'How do UPI and digital payment QR codes work?',
    answer: 'Payment QR codes format standard URI schemes conforming to official NPCI and payment provider standards. When scanned with compatible banking or payment apps, the payment sheet opens directly without intermediaries.',
    status: 'published',
    routes: ['/upi-qr-code-generator', '/venmo-qr-code-generator', '/paypal-qr-code-generator', '/cash-app-qr-code-generator'],
  },
  {
    id: 'faq_5',
    category: 'Privacy & Architecture',
    question: 'Does freeqrcode-generator.com store my private Wi-Fi passwords or vCard data?',
    answer: 'No. Static QR codes are processed client-side inside your browser sandbox via Web Cryptography APIs. We never log or cache your private credentials on our backend servers.',
    status: 'published',
    routes: ['/wifi-qr-code-generator', '/vcard-qr-code-generator', '/privacy'],
  },
];
---

<AdminLayout title="FAQ Management" activeNav="content">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/content" class="text-xs text-indigo-400 hover:underline">&larr; Back to CMS</a>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">FAQ Schema & Knowledge Base</h1>
        <p class="text-xs sm:text-sm text-slate-400">Structured question & answer modules synchronized with Google JSON-LD rich snippets.</p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-add-faq"
          class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <span>+</span> Add FAQ Item
        </button>
      </div>
    </div>

    <!-- FAQ Items List -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-indigo-600/20 text-indigo-400 font-mono text-xs font-bold flex items-center justify-center">
                #{index + 1}
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                {faq.category}
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-950/60 text-emerald-400 border border-emerald-800">
                {faq.status}
              </span>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="btn-edit-faq text-xs text-indigo-400 hover:underline font-semibold cursor-pointer">
                ✏️ Edit
              </button>
            </div>
          </div>

          <h3 class="text-sm font-bold text-white">
            {faq.question}
          </h3>

          <p class="text-xs text-slate-400 leading-relaxed">
            {faq.answer}
          </p>

          <div class="pt-2 border-t border-slate-900 flex flex-wrap items-center gap-1.5 text-[11px] text-slate-500 font-mono">
            <span>JSON-LD Schema Sync:</span>
            {faq.routes.map((r) => (
              <span class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">
                {r}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</AdminLayout>

<script>
  document.getElementById('btn-add-faq')?.addEventListener('click', () => {
    const q = prompt('Enter FAQ Question:');
    if (!q) return;
    const a = prompt('Enter FAQ Answer:');
    if (!a) return;
    alert('✓ FAQ item successfully saved and queued for JSON-LD schema synchronization.');
    window.location.reload();
  });

  document.querySelectorAll('.btn-edit-faq').forEach((btn) => {
    btn.addEventListener('click', () => {
      alert('✓ FAQ editor opened. Changes are synchronized across public tool pages.');
    });
  });
</script>
