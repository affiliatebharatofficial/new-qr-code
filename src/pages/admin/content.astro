---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { parseSessionCookie, verifySessionToken } from '../../lib/auth/jwt';

const cookieHeader = Astro.request.headers.get('cookie');
const sessionToken = parseSessionCookie(cookieHeader);
const user = sessionToken ? await verifySessionToken(sessionToken) : null;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="SEO Content Manager" activeSection="content">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">SEO & Content Manager</h1>
      <p class="text-xs text-slate-500 mt-1">Manage landing page headlines, meta descriptions, structured data, and FAQs.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">14 Static SEO Landing Routes Configured</h2>
      <p class="text-xs text-slate-500 leading-relaxed">
        All 14 dedicated landing pages (/url-to-qr-code, /wifi-qr-code-generator, /vcard-qr-code-generator, etc.) are built with static prerendering, unique JSON-LD schemas, and fast client-side generators.
      </p>
      <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
          ✓ Sitemap & Robots Auto-Generated
        </span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400">
          ✓ OpenGraph & Twitter Cards Ready
        </span>
      </div>
    </div>
  </div>
</AdminLayout>
