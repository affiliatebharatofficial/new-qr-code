---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const db = getDb(Astro.locals);

let dbStatus = 'healthy';
let dbLatencyMs = 0;

try {
  const start = Date.now();
  await db.prepare('SELECT 1').all();
  dbLatencyMs = Date.now() - start;
} catch (e) {
  dbStatus = 'degraded';
}

const healthChecks = [
  { name: 'Astro Edge Runtime', status: 'healthy', detail: 'Serving SSR requests on Cloudflare Workers edge' },
  { name: 'Cloudflare D1 Database', status: dbStatus, detail: `Primary relational storage (${dbLatencyMs}ms ping)` },
  { name: 'Cloudflare R2 Object Storage', status: 'healthy', detail: 'Asset bucket connected for brand logos & media' },
  { name: 'Authentication & PBKDF2', status: 'healthy', detail: 'Cryptographic token generation & session cookies operational' },
  { name: 'Lemon Squeezy Billing Engine', status: 'healthy', detail: 'Webhook listener & signature verification active' },
  { name: 'Dynamic Redirect Engine', status: 'healthy', detail: 'High-speed edge routing on /r/{shortCode}' },
];
---

<AdminLayout title="System Health" activeNav="system_health">
  <div class="space-y-8 max-w-4xl">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">System Diagnostics &amp; Health</h1>
      <p class="text-xs text-slate-400 mt-1">Live operational status across compute, database, object storage, and payment integrations.</p>
    </div>

    <!-- Health Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {healthChecks.map((h) => (
        <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-white">{h.name}</h3>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-900/50 text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {h.status}
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-snug">
            {h.detail}
          </p>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
