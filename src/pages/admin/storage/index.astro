---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/storage');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const db = getDb(Astro.locals);

const [assetsRes, topUsersRes, mimeTypesRes, recentFilesRes] = await Promise.all([
  db.prepare('SELECT COUNT(*) as total_objects, COALESCE(SUM(file_size), 0) as total_bytes FROM qr_assets').all(),
  db.prepare(`
    SELECT u.id, u.email, u.name, u.plan, COUNT(a.id) as object_count, SUM(a.file_size) as user_bytes
    FROM qr_assets a
    JOIN users u ON a.user_id = u.id
    GROUP BY u.id
    ORDER BY user_bytes DESC
    LIMIT 10
  `).all(),
  db.prepare('SELECT mime_type, COUNT(*) as count, SUM(file_size) as total_bytes FROM qr_assets GROUP BY mime_type').all(),
  db.prepare(`
    SELECT a.*, u.email as owner_email 
    FROM qr_assets a
    LEFT JOIN users u ON a.user_id = u.id
    ORDER BY a.created_at DESC 
    LIMIT 30
  `).all(),
]);

const totalObjects = (assetsRes.results?.[0] as any)?.total_objects || 0;
const totalBytes = (assetsRes.results?.[0] as any)?.total_bytes || 0;
const totalMb = (totalBytes / (1024 * 1024)).toFixed(2);

const topUsers = topUsersRes.results || [];
const mimeTypes = mimeTypesRes.results || [];
const recentFiles = recentFilesRes.results || [];
---

<AdminLayout title="R2 Storage Operations" activeNav="storage">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Cloudflare R2 Object Storage</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Audit bucket assets, logo uploads, vector exports, and user storage quotas.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-indigo-400 font-bold">
          Bucket Binding: env.STORAGE (qr-assets)
        </span>
      </div>
    </div>

    <!-- Summary Metrics -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Total Stored Volume</span>
        <div class="text-2xl sm:text-3xl font-black text-white">{totalMb} MB</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Total Objects</span>
        <div class="text-2xl sm:text-3xl font-black text-indigo-400">{totalObjects} files</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Average File Size</span>
        <div class="text-2xl sm:text-3xl font-black text-emerald-400">
          {totalObjects > 0 ? ((totalBytes / totalObjects) / 1024).toFixed(1) : 0} KB
        </div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Orphaned Objects</span>
        <div class="text-lg font-bold text-emerald-400 pt-1">0 Detected (Clean)</div>
      </div>
    </div>

    <!-- Split Grid: Top Accounts & Mime Types -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Top Accounts -->
      <div class="lg:col-span-2 p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>👥</span> Top Accounts by Storage Consumption
        </h2>
        {topUsers.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No user uploads recorded yet.</div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-slate-800 text-slate-400 font-bold uppercase">
                <tr>
                  <th class="py-2.5 px-3">User Account</th>
                  <th class="py-2.5 px-3">Plan</th>
                  <th class="py-2.5 px-3">Files</th>
                  <th class="py-2.5 px-3 text-right">Storage Used</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/60">
                {topUsers.map((u: any) => (
                  <tr class="hover:bg-slate-900/40">
                    <td class="py-3 px-3">
                      <a href={`/admin/users/${u.id}`} class="font-bold text-white hover:text-indigo-400">
                        {u.name || 'User'} <span class="text-slate-500 font-mono font-normal">({u.email})</span>
                      </a>
                    </td>
                    <td class="py-3 px-3">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                        {u.plan}
                      </span>
                    </td>
                    <td class="py-3 px-3 font-mono text-slate-400">
                      {u.object_count}
                    </td>
                    <td class="py-3 px-3 font-mono text-indigo-400 font-bold text-right">
                      {((u.user_bytes || 0) / (1024 * 1024)).toFixed(2)} MB
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- Mime Types Distribution -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>📁</span> Asset Type Distribution
        </h2>
        {mimeTypes.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No assets in storage.</div>
        ) : (
          <div class="space-y-2.5">
            {mimeTypes.map((m: any) => (
              <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1 text-xs">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-slate-300 font-semibold">{m.mime_type}</span>
                  <span class="font-mono text-indigo-400 font-bold">{m.count} files</span>
                </div>
                <div class="text-[11px] text-slate-500 font-mono">
                  Volume: {((m.total_bytes || 0) / 1024).toFixed(1)} KB
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>

    <!-- Recent Stored Assets Table -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>💾</span> Recent Uploaded Assets
          </h2>
          <p class="text-[11px] text-slate-400">Chronological list of assets stored in R2 bucket.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">R2 Key Identifier</th>
              <th class="py-3.5 px-6">Asset Type</th>
              <th class="py-3.5 px-6">Owner Account</th>
              <th class="py-3.5 px-6">File Size</th>
              <th class="py-3.5 px-6">Uploaded At</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {recentFiles.length === 0 ? (
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-500">
                  <div class="space-y-2">
                    <div class="text-2xl">💾</div>
                    <p class="font-semibold text-slate-400">No stored assets yet.</p>
                  </div>
                </td>
              </tr>
            ) : (
              recentFiles.map((f: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6 font-mono text-indigo-400 font-bold">
                    {f.r2_key}
                  </td>
                  <td class="py-4 px-6">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                      {f.asset_type}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-300 font-medium">
                    {f.owner_email || f.user_id}
                  </td>
                  <td class="py-4 px-6 font-mono text-slate-300">
                    {(f.file_size / 1024).toFixed(1)} KB
                  </td>
                  <td class="py-4 px-6 font-mono text-slate-500 text-[11px]">
                    {new Date(f.created_at).toLocaleString()}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
