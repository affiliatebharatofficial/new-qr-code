---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const planFilter = url.searchParams.get('plan') || '';
const statusFilter = url.searchParams.get('status') || '';

const db = getDb(Astro.locals);

let query = `
  SELECT u.*, 
    (SELECT COUNT(*) FROM qr_codes WHERE user_id = u.id) as qr_count,
    (SELECT COUNT(*) FROM qr_codes WHERE user_id = u.id AND is_dynamic = 1) as dynamic_qr_count,
    (SELECT COALESCE(SUM(file_size), 0) FROM qr_assets WHERE user_id = u.id) as storage_bytes
  FROM users u
  ORDER BY u.created_at DESC
  LIMIT 50
`;

const res = await db.prepare(query).all();
let users = res.results || [];

if (search) {
  users = users.filter((u: any) => u.email.toLowerCase().includes(search.toLowerCase()) || (u.name && u.name.toLowerCase().includes(search.toLowerCase())));
}
if (planFilter) {
  users = users.filter((u: any) => u.plan === planFilter);
}
if (statusFilter) {
  users = users.filter((u: any) => u.status === statusFilter);
}
---

<AdminLayout title="User Management" activeNav="users">
  <div class="space-y-6">
    <!-- Header & Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">User Accounts</h1>
        <p class="text-xs text-slate-400 mt-1">Manage accounts, inspect quotas, and moderate abusive accounts.</p>
      </div>

      <!-- Filters -->
      <form method="GET" class="flex items-center gap-2 flex-wrap text-xs">
        <input
          type="text"
          name="q"
          value={search}
          placeholder="Search by email..."
          class="px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:ring-1 focus:ring-indigo-500"
        />
        <select name="plan" class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-300">
          <option value="">All Plans</option>
          <option value="free" selected={planFilter === 'free'}>Free</option>
          <option value="pro" selected={planFilter === 'pro'}>Pro</option>
          <option value="business" selected={planFilter === 'business'}>Business</option>
        </select>
        <button type="submit" class="px-4 py-2 rounded-xl font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm">
          Filter
        </button>
      </form>
    </div>

    <!-- Users Table -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">User / Email</th>
              <th class="py-3.5 px-6">Plan</th>
              <th class="py-3.5 px-6">Status</th>
              <th class="py-3.5 px-6">QRs (Dyn)</th>
              <th class="py-3.5 px-6">Storage</th>
              <th class="py-3.5 px-6">Joined</th>
              <th class="py-3.5 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {users.length === 0 ? (
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-500">No users found matching your search.</td>
              </tr>
            ) : (
              users.map((u: any) => {
                const mb = (u.storage_bytes / (1024 * 1024)).toFixed(1);
                return (
                  <tr class="hover:bg-slate-900/40 transition-colors">
                    <td class="py-4 px-6">
                      <a href={`/admin/users/${u.id}`} class="font-bold text-white hover:text-indigo-400 transition-colors">
                        {u.email}
                      </a>
                      <div class="text-[10px] text-slate-500 font-mono">{u.id}</div>
                    </td>
                    <td class="py-4 px-6">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                        u.plan === 'business' ? 'bg-amber-900/50 text-amber-300' : u.plan === 'pro' ? 'bg-indigo-900/50 text-indigo-300' : 'bg-slate-800 text-slate-400'
                      }`}>
                        {u.plan}
                      </span>
                    </td>
                    <td class="py-4 px-6">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                        u.status === 'active' ? 'bg-emerald-900/50 text-emerald-300' : 'bg-red-900/50 text-red-300'
                      }`}>
                        {u.status}
                      </span>
                    </td>
                    <td class="py-4 px-6 text-slate-300 font-bold">
                      {u.qr_count} <span class="text-slate-500 font-normal">({u.dynamic_qr_count})</span>
                    </td>
                    <td class="py-4 px-6 text-slate-400 font-mono">
                      {mb} MB
                    </td>
                    <td class="py-4 px-6 text-slate-500 font-mono text-[11px]">
                      {new Date(u.created_at).toLocaleDateString()}
                    </td>
                    <td class="py-4 px-6 text-right space-x-1">
                      <a href={`/admin/users/${u.id}`} class="p-1.5 rounded-lg text-indigo-400 hover:bg-slate-900 font-semibold">
                        Inspect
                      </a>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
