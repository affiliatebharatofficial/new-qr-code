---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const { id } = Astro.params;
const db = getDb(Astro.locals);

const userRes = await db.prepare('SELECT * FROM users WHERE id = ?').bind(id).all();
const targetUser = userRes.results?.[0] as any;

if (!targetUser) {
  return Astro.redirect('/admin/users');
}

const [qrsRes, landingRes, assetsRes, auditsRes] = await Promise.all([
  db.prepare('SELECT * FROM qr_codes WHERE user_id = ? ORDER BY created_at DESC').bind(id).all(),
  db.prepare('SELECT * FROM landing_pages WHERE user_id = ? ORDER BY created_at DESC').bind(id).all(),
  db.prepare('SELECT * FROM qr_assets WHERE user_id = ?').bind(id).all(),
  db.prepare("SELECT * FROM admin_audit_logs WHERE resource_id = ? ORDER BY created_at DESC").bind(id).all(),
]);

const userQrs = qrsRes.results || [];
const userLandingPages = landingRes.results || [];
const userAssets = assetsRes.results || [];
const userAudits = auditsRes.results || [];

const totalStorageBytes = userAssets.reduce((acc: number, item: any) => acc + (item.file_size || 0), 0);
const storageMb = (totalStorageBytes / (1024 * 1024)).toFixed(2);
---

<AdminLayout title={`User: ${targetUser.email}`} activeNav="users">
  <div class="space-y-8 max-w-5xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <a href="/admin/users" class="text-xs font-semibold text-indigo-400 hover:underline">&larr; Back to Users</a>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">{targetUser.email}</h1>
        <p class="text-xs font-mono text-slate-500 mt-0.5">User ID: {targetUser.id} • Role: {targetUser.role}</p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="toggle-user-status-btn"
          data-id={targetUser.id}
          data-status={targetUser.status}
          class={`px-4 py-2.5 rounded-xl font-bold text-xs cursor-pointer shadow-sm transition-all ${
            targetUser.status === 'active'
              ? 'bg-red-600/20 text-red-400 border border-red-500/30 hover:bg-red-600 hover:text-white'
              : 'bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-600 hover:text-white'
          }`}
        >
          {targetUser.status === 'active' ? 'Disable Account 🛑' : 'Re-Enable Account 🟢'}
        </button>
      </div>
    </div>

    <!-- Account Details Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-[11px] font-semibold text-slate-400 uppercase">Subscription Plan</span>
        <div class="text-lg font-bold text-white uppercase">{targetUser.plan}</div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-[11px] font-semibold text-slate-400 uppercase">Account Status</span>
        <div class={`text-lg font-bold uppercase ${targetUser.status === 'active' ? 'text-emerald-400' : 'text-red-400'}`}>
          {targetUser.status}
        </div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-[11px] font-semibold text-slate-400 uppercase">QR Codes</span>
        <div class="text-lg font-bold text-indigo-400">{userQrs.length}</div>
      </div>
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-[11px] font-semibold text-slate-400 uppercase">Storage Used</span>
        <div class="text-lg font-bold text-slate-200">{storageMb} MB</div>
      </div>
    </div>

    <!-- User's QR Codes -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider">User QR Codes ({userQrs.length})</h2>
      {userQrs.length === 0 ? (
        <p class="text-xs text-slate-500">No QR codes created yet.</p>
      ) : (
        <div class="divide-y divide-slate-800 text-xs">
          {userQrs.map((q: any) => (
            <div class="py-3 flex items-center justify-between gap-4">
              <div>
                <span class="font-bold text-white">{q.name}</span>
                <div class="text-[10px] text-slate-500 font-mono">{q.type} • {q.is_dynamic ? 'Dynamic' : 'Static'}</div>
              </div>
              <div class="text-right">
                <span class="font-bold text-slate-300">{q.scans_count || 0} scans</span>
                <span class={`ml-2 px-2 py-0.5 rounded text-[10px] uppercase font-bold ${q.status === 'active' ? 'bg-emerald-900/40 text-emerald-400' : 'bg-red-900/40 text-red-400'}`}>
                  {q.status}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- User's Hosted Landing Pages -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider">Hosted Landing Pages ({userLandingPages.length})</h2>
      {userLandingPages.length === 0 ? (
        <p class="text-xs text-slate-500">No landing pages created.</p>
      ) : (
        <div class="divide-y divide-slate-800 text-xs">
          {userLandingPages.map((lp: any) => (
            <div class="py-3 flex items-center justify-between gap-4">
              <div>
                <a href={`/p/${lp.slug}`} target="_blank" class="font-bold text-white hover:text-indigo-400">
                  {lp.title} ↗
                </a>
                <div class="text-[10px] text-slate-500 font-mono">{lp.type} • /p/{lp.slug}</div>
              </div>
              <span class={`px-2 py-0.5 rounded text-[10px] uppercase font-bold ${lp.status === 'published' ? 'bg-emerald-900/40 text-emerald-400' : 'bg-slate-800 text-slate-400'}`}>
                {lp.status}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  document.getElementById('toggle-user-status-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('toggle-user-status-btn');
    const id = btn?.getAttribute('data-id');
    const curStatus = btn?.getAttribute('data-status');
    const newStatus = curStatus === 'active' ? 'disabled' : 'active';
    
    if (!confirm(`Are you sure you want to change this account status to ${newStatus}?`)) return;

    try {
      const res = await fetch(`/api/admin/users/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      });
      if (res.ok) window.location.reload();
      else alert('Failed to update user status.');
    } catch {
      alert('Error updating user status.');
    }
  });
</script>
