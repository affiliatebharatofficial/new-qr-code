---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/dynamic-qr');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const statusFilter = url.searchParams.get('status') || 'all';

const db = getDb(Astro.locals);

let query = `
  SELECT q.*, u.email as owner_email, u.name as owner_name 
  FROM qr_codes q
  LEFT JOIN users u ON q.user_id = u.id
  WHERE q.is_dynamic = 1
`;
const params: any[] = [];

if (search) {
  query += ' AND (q.name LIKE ? OR q.short_code LIKE ? OR q.destination LIKE ? OR u.email LIKE ?)';
  const term = `%${search}%`;
  params.push(term, term, term, term);
}

if (statusFilter !== 'all') {
  query += ' AND q.status = ?';
  params.push(statusFilter);
}

query += ' ORDER BY q.created_at DESC LIMIT 100';

const [qrsRes, statsRes] = await Promise.all([
  db.prepare(query).bind(...params).all(),
  db.prepare(`
    SELECT 
      COUNT(*) as total_dynamic,
      SUM(scans_count) as total_scans,
      SUM(CASE WHEN status = 'active' THEN 1 ELSE 0 END) as active_count,
      SUM(CASE WHEN status != 'active' THEN 1 ELSE 0 END) as disabled_count
    FROM qr_codes 
    WHERE is_dynamic = 1
  `).all(),
]);

const dynamicQrs = qrsRes.results || [];
const stats = (statsRes.results?.[0] as any) || {};
---

<AdminLayout title="Dynamic QR & Short Links" activeNav="dynamic_qr">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Dynamic QR & Short Link Router</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Inspect edge-redirected campaigns, monitor destination URLs, and manage link lifecycle.</p>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin/scans" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5">
          <span>📡</span> Global Scan Telemetry
        </a>
      </div>
    </div>

    <!-- Overview Counters -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Dynamic QRs</span>
        <div class="text-2xl sm:text-3xl font-black text-indigo-400">{stats.total_dynamic || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Total Campaign Scans</span>
        <div class="text-2xl sm:text-3xl font-black text-emerald-400">{stats.total_scans || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Active Links</span>
        <div class="text-2xl sm:text-3xl font-black text-white">{stats.active_count || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Disabled / Paused</span>
        <div class="text-2xl sm:text-3xl font-black text-red-400">{stats.disabled_count || 0}</div>
      </div>
    </div>

    <!-- Search & Filters Bar -->
    <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <form method="GET" class="w-full sm:w-80 relative">
        <input
          type="text"
          name="q"
          value={search}
          placeholder="Search by slug, URL, or owner email..."
          class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
        <span class="absolute left-3 top-2.5 text-slate-500 text-xs">🔍</span>
      </form>

      <div class="flex items-center gap-2 text-xs font-semibold">
        <a
          href={`/admin/dynamic-qr?status=all${search ? `&q=${search}` : ''}`}
          class={`px-3 py-1.5 rounded-lg ${statusFilter === 'all' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'}`}
        >
          All
        </a>
        <a
          href={`/admin/dynamic-qr?status=active${search ? `&q=${search}` : ''}`}
          class={`px-3 py-1.5 rounded-lg ${statusFilter === 'active' ? 'bg-emerald-600 text-white' : 'text-slate-400 hover:text-white'}`}
        >
          Active
        </a>
        <a
          href={`/admin/dynamic-qr?status=disabled${search ? `&q=${search}` : ''}`}
          class={`px-3 py-1.5 rounded-lg ${statusFilter === 'disabled' ? 'bg-red-600 text-white' : 'text-slate-400 hover:text-white'}`}
        >
          Disabled
        </a>
      </div>
    </div>

    <!-- Dynamic QRs Table -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">Campaign Name & Slug</th>
              <th class="py-3.5 px-6">Target Destination</th>
              <th class="py-3.5 px-6">Owner Account</th>
              <th class="py-3.5 px-6">Scans</th>
              <th class="py-3.5 px-6">Status</th>
              <th class="py-3.5 px-6">Created</th>
              <th class="py-3.5 px-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {dynamicQrs.length === 0 ? (
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-500">
                  <div class="space-y-2">
                    <div class="text-2xl">🔗</div>
                    <p class="font-semibold text-slate-400">No dynamic QR codes found.</p>
                  </div>
                </td>
              </tr>
            ) : (
              dynamicQrs.map((q: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6">
                    <span class="font-bold text-white block">{q.name}</span>
                    <span class="font-mono text-indigo-400 text-[11px]">/r/{q.short_code}</span>
                  </td>
                  <td class="py-4 px-6 max-w-xs truncate font-mono text-[11px] text-slate-300">
                    <a href={q.destination} target="_blank" rel="noopener" class="hover:underline hover:text-indigo-400">
                      {q.destination || '—'}
                    </a>
                  </td>
                  <td class="py-4 px-6">
                    <a href={`/admin/users/${q.user_id}`} class="text-slate-300 hover:text-white font-medium hover:underline">
                      {q.owner_email || 'Guest / Unassigned'}
                    </a>
                  </td>
                  <td class="py-4 px-6 font-mono text-emerald-400 font-bold">
                    {q.scans_count || 0}
                  </td>
                  <td class="py-4 px-6">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      q.status === 'active' ? 'bg-emerald-900/50 text-emerald-300' : 'bg-red-900/50 text-red-300'
                    }`}>
                      {q.status}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-mono text-[11px]">
                    {new Date(q.created_at).toLocaleDateString()}
                  </td>
                  <td class="py-4 px-6 text-right">
                    <button
                      type="button"
                      class="btn-toggle-qr-status text-xs font-semibold cursor-pointer underline px-2 py-1 rounded transition-colors"
                      data-qr-id={q.id}
                      data-current-status={q.status}
                    >
                      {q.status === 'active' ? 'Pause / Disable' : 'Enable Link'}
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.btn-toggle-qr-status').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const qrId = btn.getAttribute('data-qr-id');
      const currStatus = btn.getAttribute('data-current-status');
      const newStatus = currStatus === 'active' ? 'disabled' : 'active';

      if (!confirm(`Are you sure you want to change status of QR [${qrId}] to ${newStatus.toUpperCase()}?`)) return;

      try {
        const res = await fetch(`/api/admin/qr-codes/${qrId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (!res.ok) throw new Error('Failed to update QR status.');
        window.location.reload();
      } catch (err: any) {
        alert(err?.message || 'Error changing QR code status.');
      }
    });
  });
</script>
