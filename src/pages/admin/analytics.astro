---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../lib/auth/jwt';
import { getDb } from '../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/analytics');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const range = url.searchParams.get('range') || '30d';

const now = Date.now();
let periodMs = 30 * 24 * 60 * 60 * 1000;
let periodLabel = 'Last 30 Days';

if (range === 'today') {
  periodMs = 24 * 60 * 60 * 1000;
  periodLabel = 'Today (24h)';
} else if (range === '7d') {
  periodMs = 7 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 7 Days';
} else if (range === '90d') {
  periodMs = 90 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 90 Days';
} else if (range === '12m') {
  periodMs = 365 * 24 * 60 * 60 * 1000;
  periodLabel = 'Last 12 Months';
}

const currentPeriodStart = now - periodMs;
const prevPeriodStart = currentPeriodStart - periodMs;

const db = getDb(Astro.locals);

// Fetch current vs previous period stats for growth comparison
const [
  currentUsersRes,
  prevUsersRes,
  currentQrsRes,
  prevQrsRes,
  currentScansRes,
  prevScansRes,
  topCountriesRes,
  topDevicesRes,
  topBrowsersRes,
  recentScansRes,
] = await Promise.all([
  db.prepare('SELECT COUNT(*) as count FROM users WHERE created_at >= ?').bind(currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM users WHERE created_at >= ? AND created_at < ?').bind(prevPeriodStart, currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM qr_codes WHERE created_at >= ?').bind(currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM qr_codes WHERE created_at >= ? AND created_at < ?').bind(prevPeriodStart, currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM qr_scans WHERE scanned_at >= ?').bind(currentPeriodStart).all(),
  db.prepare('SELECT COUNT(*) as count FROM qr_scans WHERE scanned_at >= ? AND scanned_at < ?').bind(prevPeriodStart, currentPeriodStart).all(),
  db.prepare("SELECT country, COUNT(*) as count FROM qr_scans WHERE scanned_at >= ? AND country != 'Unknown' GROUP BY country ORDER BY count DESC LIMIT 8").bind(currentPeriodStart).all(),
  db.prepare('SELECT device_type, COUNT(*) as count FROM qr_scans WHERE scanned_at >= ? GROUP BY device_type ORDER BY count DESC LIMIT 5').bind(currentPeriodStart).all(),
  db.prepare('SELECT browser, COUNT(*) as count FROM qr_scans WHERE scanned_at >= ? GROUP BY browser ORDER BY count DESC LIMIT 5').bind(currentPeriodStart).all(),
  db.prepare('SELECT * FROM qr_scans ORDER BY scanned_at DESC LIMIT 30').all(),
]);

const currentUsers = (currentUsersRes.results?.[0] as any)?.count || 0;
const prevUsers = (prevUsersRes.results?.[0] as any)?.count || 0;
const currentQrs = (currentQrsRes.results?.[0] as any)?.count || 0;
const prevQrs = (prevQrsRes.results?.[0] as any)?.count || 0;
const currentScans = (currentScansRes.results?.[0] as any)?.count || 0;
const prevScans = (prevScansRes.results?.[0] as any)?.count || 0;

const computeGrowth = (curr: number, prev: number) => {
  if (prev === 0) return curr > 0 ? '+100%' : '0%';
  const pct = Math.round(((curr - prev) / prev) * 100);
  return pct >= 0 ? `+${pct}%` : `${pct}%`;
};

const usersGrowth = computeGrowth(currentUsers, prevUsers);
const qrsGrowth = computeGrowth(currentQrs, prevQrs);
const scansGrowth = computeGrowth(currentScans, prevScans);

const topCountries = topCountriesRes.results || [];
const topDevices = topDevicesRes.results || [];
const topBrowsers = topBrowsersRes.results || [];
const recentScans = recentScansRes.results || [];
---

<AdminLayout title="Analytics & Growth" activeNav="analytics">
  <div class="space-y-8">
    
    <!-- Top Header & Date Filter Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Analytics & Growth Engine</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Time-series telemetry, customer acquisition, and campaign scan volume.</p>
      </div>

      <!-- Date Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 bg-slate-950 p-1 rounded-2xl border border-slate-800 text-xs">
        <a
          href="/admin/analytics?range=today"
          class={`px-3 py-1.5 rounded-xl font-bold transition-colors ${
            range === 'today' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
          }`}
        >
          Today
        </a>
        <a
          href="/admin/analytics?range=7d"
          class={`px-3 py-1.5 rounded-xl font-bold transition-colors ${
            range === '7d' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
          }`}
        >
          7 Days
        </a>
        <a
          href="/admin/analytics?range=30d"
          class={`px-3 py-1.5 rounded-xl font-bold transition-colors ${
            range === '30d' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
          }`}
        >
          30 Days
        </a>
        <a
          href="/admin/analytics?range=90d"
          class={`px-3 py-1.5 rounded-xl font-bold transition-colors ${
            range === '90d' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
          }`}
        >
          90 Days
        </a>
        <a
          href="/admin/analytics?range=12m"
          class={`px-3 py-1.5 rounded-xl font-bold transition-colors ${
            range === '12m' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
          }`}
        >
          12 Months
        </a>
      </div>
    </div>

    <!-- Comparative KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase">New User Signups</span>
          <span class={`text-xs font-bold px-2 py-0.5 rounded-md ${
            usersGrowth.startsWith('+') ? 'bg-emerald-950/60 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-400'
          }`}>
            {usersGrowth}
          </span>
        </div>
        <div class="text-3xl font-black text-white">{currentUsers}</div>
        <p class="text-[11px] text-slate-500 font-mono">vs. {prevUsers} in previous {periodLabel.toLowerCase()}</p>
      </div>

      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase">QR Codes Created</span>
          <span class={`text-xs font-bold px-2 py-0.5 rounded-md ${
            qrsGrowth.startsWith('+') ? 'bg-indigo-950/60 text-indigo-400 border border-indigo-800' : 'bg-slate-800 text-slate-400'
          }`}>
            {qrsGrowth}
          </span>
        </div>
        <div class="text-3xl font-black text-indigo-400">{currentQrs}</div>
        <p class="text-[11px] text-slate-500 font-mono">vs. {prevQrs} in previous {periodLabel.toLowerCase()}</p>
      </div>

      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400 uppercase">Campaign Scan Volume</span>
          <span class={`text-xs font-bold px-2 py-0.5 rounded-md ${
            scansGrowth.startsWith('+') ? 'bg-emerald-950/60 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-400'
          }`}>
            {scansGrowth}
          </span>
        </div>
        <div class="text-3xl font-black text-emerald-400">{currentScans}</div>
        <p class="text-[11px] text-slate-500 font-mono">vs. {prevScans} in previous {periodLabel.toLowerCase()}</p>
      </div>

    </div>

    <!-- Geographic & Device Breakdown Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Top Countries -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>🌍</span> Top Geographic Markets ({periodLabel})
        </h2>
        {topCountries.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No country scan events for this time window.</div>
        ) : (
          <div class="space-y-2.5">
            {topCountries.map((c: any) => (
              <div class="flex items-center justify-between text-xs">
                <span class="font-medium text-slate-300">{c.country}</span>
                <span class="font-mono text-emerald-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                  {c.count} scans
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Device Platform -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>📱</span> Device Distribution
        </h2>
        {topDevices.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No device events recorded.</div>
        ) : (
          <div class="space-y-2.5">
            {topDevices.map((d: any) => (
              <div class="flex items-center justify-between text-xs">
                <span class="font-medium text-slate-300 capitalize">{d.device_type}</span>
                <span class="font-mono text-indigo-300 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                  {d.count} scans
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Browser Distribution -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>🌐</span> Browser Client Telemetry
        </h2>
        {topBrowsers.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No browser events recorded.</div>
        ) : (
          <div class="space-y-2.5">
            {topBrowsers.map((b: any) => (
              <div class="flex items-center justify-between text-xs">
                <span class="font-medium text-slate-300">{b.browser}</span>
                <span class="font-mono text-slate-300 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                  {b.count} scans
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>

    <!-- Live Telemetry Stream Table -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm space-y-3">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>📡</span> Live Edge Scan Stream (Last 30 Events)
          </h2>
          <p class="text-[11px] text-slate-400">Privacy-preserving telemetry received at Cloudflare edge worker endpoints.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3 px-6">Timestamp</th>
              <th class="py-3 px-6">QR Code ID</th>
              <th class="py-3 px-6">Location</th>
              <th class="py-3 px-6">Device</th>
              <th class="py-3 px-6">Browser / OS</th>
              <th class="py-3 px-6">Referrer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {recentScans.length === 0 ? (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500">
                  No scan telemetry events recorded yet.
                </td>
              </tr>
            ) : (
              recentScans.map((s: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-3 px-6 font-mono text-slate-400 text-[11px]">
                    {new Date(s.scanned_at).toLocaleString()}
                  </td>
                  <td class="py-3 px-6 font-mono text-indigo-400">
                    <a href={`/admin/qr-codes`} class="hover:underline">
                      {s.qr_id}
                    </a>
                  </td>
                  <td class="py-3 px-6 text-slate-200">
                    {s.country || 'Unknown'}, {s.city || 'Unknown'}
                  </td>
                  <td class="py-3 px-6 capitalize text-slate-300 font-medium">
                    {s.device_type}
                  </td>
                  <td class="py-3 px-6 text-slate-400 text-[11px]">
                    {s.browser} / {s.os}
                  </td>
                  <td class="py-3 px-6 text-slate-500 text-[11px] truncate max-w-[150px]">
                    {s.referrer || 'Direct'}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
