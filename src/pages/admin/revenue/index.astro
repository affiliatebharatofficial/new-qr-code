---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/revenue');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const db = getDb(Astro.locals);

const [subsRes, planBreakdownRes, webhooksRes] = await Promise.all([
  db.prepare(`
    SELECT s.*, u.email as user_email, u.name as user_name 
    FROM subscriptions s
    LEFT JOIN users u ON s.user_id = u.id
    ORDER BY s.created_at DESC
    LIMIT 50
  `).all(),
  db.prepare('SELECT plan, COUNT(*) as count FROM users GROUP BY plan').all(),
  db.prepare('SELECT * FROM webhook_events ORDER BY created_at DESC LIMIT 10').all(),
]);

const subscriptions = subsRes.results || [];
const webhooks = webhooksRes.results || [];

const planCounts: Record<string, number> = {};
(planBreakdownRes.results || []).forEach((row: any) => {
  planCounts[row.plan] = row.count;
});

const proCount = planCounts['pro'] || 0;
const businessCount = planCounts['business'] || 0;
const enterpriseCount = planCounts['enterprise'] || 0;

const mrr = (proCount * 9) + (businessCount * 29) + (enterpriseCount * 79);
const arr = mrr * 12;
const totalPaidSubscribers = proCount + businessCount + enterpriseCount;
---

<AdminLayout title="Revenue & Financial Dashboard" activeNav="revenue">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Revenue & Billing Ledger</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Lemon Squeezy merchant transactions, recurring subscriptions, and MRR metrics.</p>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin/subscriptions" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm transition-colors flex items-center gap-1.5">
          <span>💳</span> Manage Plans & Grants
        </a>
        <a href="/admin/billing/webhooks" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5">
          <span>⚡</span> Webhook Logs
        </a>
      </div>
    </div>

    <!-- Financial KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Monthly Recurring (MRR)</span>
        <div class="text-2xl sm:text-3xl font-black text-emerald-400">${mrr} <span class="text-xs text-slate-500 font-normal">/ mo</span></div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Annual Run Rate (ARR)</span>
        <div class="text-2xl sm:text-3xl font-black text-white">${arr} <span class="text-xs text-slate-500 font-normal">/ yr</span></div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Paid Subscribers</span>
        <div class="text-2xl sm:text-3xl font-black text-indigo-400">{totalPaidSubscribers}</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs font-semibold text-slate-400 uppercase">Merchant of Record</span>
        <div class="text-lg font-bold text-amber-400 pt-1">Lemon Squeezy</div>
      </div>
    </div>

    <!-- Revenue Breakdown by Plan Tier -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Pro Plan Tier Card -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-indigo-500/40 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">Pro Tier ($9/mo)</span>
          <span class="text-xs font-mono bg-indigo-950/60 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800">
            {proCount} subs
          </span>
        </div>
        <div class="text-2xl font-black text-white">${proCount * 9} <span class="text-xs text-slate-500 font-normal">MRR</span></div>
        <p class="text-xs text-slate-400">100 Dynamic QRs, 500 Saved QRs, 365-day analytics.</p>
      </div>

      <!-- Business Plan Tier Card -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-purple-500/40 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-purple-400">Business Tier ($29/mo)</span>
          <span class="text-xs font-mono bg-purple-950/60 text-purple-300 px-2 py-0.5 rounded border border-purple-800">
            {businessCount} subs
          </span>
        </div>
        <div class="text-2xl font-black text-white">${businessCount * 29} <span class="text-xs text-slate-500 font-normal">MRR</span></div>
        <p class="text-xs text-slate-400">1,000 Dynamic QRs, Unlimited storage, Bulk CSV.</p>
      </div>

      <!-- Enterprise Tier Card -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Enterprise Tier ($79/mo)</span>
          <span class="text-xs font-mono bg-slate-900 text-slate-400 px-2 py-0.5 rounded border border-slate-800">
            {enterpriseCount} subs
          </span>
        </div>
        <div class="text-2xl font-black text-white">${enterpriseCount * 79} <span class="text-xs text-slate-500 font-normal">MRR</span></div>
        <p class="text-xs text-slate-400">Custom volume, Dedicated API, Priority SLA.</p>
      </div>

    </div>

    <!-- Active Subscription Ledger -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>💳</span> Customer Subscriptions & Transaction Ledger
          </h2>
          <p class="text-[11px] text-slate-400">Authoritative subscriber records synchronized via Lemon Squeezy webhooks.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">Customer / User</th>
              <th class="py-3.5 px-6">Plan</th>
              <th class="py-3.5 px-6">Billing Status</th>
              <th class="py-3.5 px-6">Customer Identifier</th>
              <th class="py-3.5 px-6">Period End</th>
              <th class="py-3.5 px-6">Created Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {subscriptions.length === 0 ? (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500">
                  <div class="space-y-2">
                    <div class="text-2xl">💳</div>
                    <p class="font-semibold text-slate-400">No active customer subscriptions recorded yet.</p>
                  </div>
                </td>
              </tr>
            ) : (
              subscriptions.map((s: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6 font-bold text-white">
                    <a href={`/admin/users/${s.user_id}`} class="hover:text-indigo-400">
                      {s.user_name || 'User'} <span class="text-slate-500 font-mono font-normal">({s.user_email || s.user_id})</span>
                    </a>
                  </td>
                  <td class="py-4 px-6">
                    <span class="px-2.5 py-1 rounded text-[10px] font-bold uppercase bg-indigo-900/50 text-indigo-300">
                      {s.plan}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      s.status === 'active' || s.status === 'trialing' ? 'bg-emerald-900/50 text-emerald-300' : 'bg-amber-900/50 text-amber-300'
                    }`}>
                      {s.status}
                    </span>
                  </td>
                  <td class="py-4 px-6 font-mono text-slate-400 text-[11px]">
                    {s.customer_id || 'manual_grant'}
                  </td>
                  <td class="py-4 px-6 text-slate-300 font-mono text-[11px]">
                    {s.current_period_end ? new Date(s.current_period_end).toLocaleDateString() : 'Lifetime'}
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-mono text-[11px]">
                    {new Date(s.created_at).toLocaleDateString()}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
