---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/scans');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const countryFilter = url.searchParams.get('country') || 'all';

const db = getDb(Astro.locals);

let query = `
  SELECT s.*, q.name as qr_name, q.type as qr_type, q.short_code 
  FROM qr_scans s
  LEFT JOIN qr_codes q ON s.qr_id = q.id
`;
const params: any[] = [];

if (countryFilter !== 'all') {
  query += ' WHERE s.country = ?';
  params.push(countryFilter);
}

query += ' ORDER BY s.scanned_at DESC LIMIT 100';

const [scansRes, countriesRes, devicesRes, qrTypeScansRes, totalScansRes] = await Promise.all([
  db.prepare(query).bind(...params).all(),
  db.prepare("SELECT country, COUNT(*) as count FROM qr_scans WHERE country != 'Unknown' GROUP BY country ORDER BY count DESC LIMIT 10").all(),
  db.prepare('SELECT device_type, COUNT(*) as count FROM qr_scans GROUP BY device_type ORDER BY count DESC').all(),
  db.prepare(`
    SELECT q.type, COUNT(s.id) as count 
    FROM qr_scans s 
    JOIN qr_codes q ON s.qr_id = q.id 
    GROUP BY q.type 
    ORDER BY count DESC 
    LIMIT 6
  `).all(),
  db.prepare('SELECT COUNT(*) as total FROM qr_scans').all(),
]);

const scans = scansRes.results || [];
const countries = countriesRes.results || [];
const devices = devicesRes.results || [];
const qrTypeScans = qrTypeScansRes.results || [];
const totalScans = (totalScansRes.results?.[0] as any)?.total || 0;
---

<AdminLayout title="Global Scan Telemetry" activeNav="scans">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Scan Telemetry & Geo Analytics</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Privacy-preserving real-time scan events, geographic resolution, and device platforms.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-emerald-400 font-bold">
          Total Logged Scans: {totalScans}
        </span>
      </div>
    </div>

    <!-- 3 Distribution Breakdown Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Top Geographic Locations -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>🌍</span> Top Scan Countries
          </h2>
          {countryFilter !== 'all' && (
            <a href="/admin/scans" class="text-[11px] text-indigo-400 hover:underline">Reset Filter</a>
          )}
        </div>
        {countries.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No country data available.</div>
        ) : (
          <div class="space-y-2">
            {countries.map((c: any) => (
              <a
                href={`/admin/scans?country=${encodeURIComponent(c.country)}`}
                class={`flex items-center justify-between text-xs p-2 rounded-xl transition-colors ${
                  countryFilter === c.country ? 'bg-indigo-900/40 border border-indigo-700 text-white font-bold' : 'hover:bg-slate-900 text-slate-300'
                }`}
              >
                <span>{c.country}</span>
                <span class="font-mono text-emerald-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                  {c.count}
                </span>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Device Platform Distribution -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>📱</span> Device Platform
        </h2>
        {devices.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No device data available.</div>
        ) : (
          <div class="space-y-2">
            {devices.map((d: any) => (
              <div class="flex items-center justify-between text-xs p-2 rounded-xl bg-slate-900/40 border border-slate-800/60">
                <span class="font-medium text-slate-300 capitalize">{d.device_type}</span>
                <span class="font-mono text-indigo-300 font-bold">
                  {d.count} scans
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- QR Type Scans -->
      <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <span>🏷️</span> Scans by QR Type
        </h2>
        {qrTypeScans.length === 0 ? (
          <div class="py-8 text-center text-xs text-slate-500">No scans logged by QR type.</div>
        ) : (
          <div class="space-y-2">
            {qrTypeScans.map((t: any) => (
              <div class="flex items-center justify-between text-xs p-2 rounded-xl bg-slate-900/40 border border-slate-800/60">
                <span class="font-bold text-slate-300 uppercase tracking-wider text-[11px]">{t.type}</span>
                <span class="font-mono text-amber-400 font-bold">
                  {t.count}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>

    <!-- Live Telemetry Stream Table -->
    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span>📡</span> Real-Time Scan Event Stream
          </h2>
          <p class="text-[11px] text-slate-400">Chronological feed of edge router redirection events.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">Timestamp</th>
              <th class="py-3.5 px-6">Campaign / QR ID</th>
              <th class="py-3.5 px-6">Location</th>
              <th class="py-3.5 px-6">Device</th>
              <th class="py-3.5 px-6">Browser & OS</th>
              <th class="py-3.5 px-6">Referrer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {scans.length === 0 ? (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500">
                  <div class="space-y-2">
                    <div class="text-2xl">📡</div>
                    <p class="font-semibold text-slate-400">No scan telemetry records found.</p>
                  </div>
                </td>
              </tr>
            ) : (
              scans.map((s: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6 font-mono text-slate-400 text-[11px]">
                    {new Date(s.scanned_at).toLocaleString()}
                  </td>
                  <td class="py-4 px-6">
                    <span class="font-bold text-white block">{s.qr_name || 'Dynamic Link'}</span>
                    <span class="font-mono text-indigo-400 text-[11px]">{s.qr_id}</span>
                  </td>
                  <td class="py-4 px-6 text-slate-200">
                    {s.country || 'Unknown'}, {s.city || 'Unknown'}
                  </td>
                  <td class="py-4 px-6 capitalize text-slate-300 font-medium">
                    {s.device_type}
                  </td>
                  <td class="py-4 px-6 text-slate-400 text-[11px]">
                    {s.browser} / {s.os}
                  </td>
                  <td class="py-4 px-6 text-slate-500 text-[11px] truncate max-w-[150px]">
                    {s.referrer || 'Direct Scan'}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
