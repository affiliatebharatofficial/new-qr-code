---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const db = getDb(Astro.locals);

const res = await db.prepare(`
  SELECT lp.*, u.email as owner_email,
    (SELECT COUNT(*) FROM landing_page_reports WHERE page_id = lp.id) as report_count
  FROM landing_pages lp
  LEFT JOIN users u ON lp.user_id = u.id
  ORDER BY lp.created_at DESC
  LIMIT 50
`).all();

const pages = res.results || [];
---

<AdminLayout title="Landing Page Management" activeNav="landing_pages">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Hosted Landing Pages</h1>
        <p class="text-xs text-slate-400 mt-1">Review hosted user landing pages, inspect reported content, and disable malicious pages.</p>
      </div>
    </div>

    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">Title / Slug</th>
              <th class="py-3.5 px-6">Type</th>
              <th class="py-3.5 px-6">Owner</th>
              <th class="py-3.5 px-6">Status</th>
              <th class="py-3.5 px-6">Reports</th>
              <th class="py-3.5 px-6">Created</th>
              <th class="py-3.5 px-6 text-right">Moderation</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {pages.length === 0 ? (
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-500">No landing pages found.</td>
              </tr>
            ) : (
              pages.map((p: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6 font-bold text-white">
                    <a href={`/p/${p.slug}`} target="_blank" class="hover:text-indigo-400 transition-colors">
                      {p.title} ↗
                    </a>
                    <div class="text-[10px] text-slate-500 font-mono">/p/{p.slug}</div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                      {p.type}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-300">
                    {p.owner_email || p.user_id}
                  </td>
                  <td class="py-4 px-6">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      p.status === 'published' ? 'bg-emerald-900/50 text-emerald-300' : 'bg-slate-800 text-slate-400'
                    }`}>
                      {p.status}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    {p.report_count > 0 ? (
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-900/60 text-red-300">
                        {p.report_count} reports 🚨
                      </span>
                    ) : (
                      <span class="text-slate-500">0</span>
                    )}
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-mono text-[11px]">
                    {new Date(p.created_at).toLocaleDateString()}
                  </td>
                  <td class="py-4 px-6 text-right space-x-1">
                    <button
                      type="button"
                      class="toggle-page-status-btn px-3 py-1 rounded-lg text-xs font-semibold cursor-pointer border transition-colors"
                      data-id={p.id}
                      data-status={p.status}
                    >
                      {p.status === 'published' ? 'Disable 🛑' : 'Publish 🟢'}
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.toggle-page-status-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const curStatus = btn.getAttribute('data-status');
      const newStatus = curStatus === 'published' ? 'disabled' : 'published';

      if (!confirm(`Are you sure you want to change this landing page status to ${newStatus}?`)) return;

      try {
        const res = await fetch(`/api/admin/landing-pages/${id}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        if (res.ok) window.location.reload();
        else alert('Failed to update landing page status.');
      } catch {
        alert('Error updating page status.');
      }
    });
  });
</script>
