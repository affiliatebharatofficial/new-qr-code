---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const db = getDb(Astro.locals);

const res = await db.prepare(`
  SELECT s.*, u.email as user_email
  FROM subscriptions s
  LEFT JOIN users u ON s.user_id = u.id
  ORDER BY s.created_at DESC
  LIMIT 50
`).all();

const subscriptions = res.results || [];
---

<AdminLayout title="Subscriptions" activeNav="subscriptions">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Subscription Management</h1>
      <p class="text-xs text-slate-400 mt-1">Lemon Squeezy customer billing state, renewals, and plan synchronizations.</p>
    </div>

    <div class="bg-slate-950 rounded-3xl border border-slate-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-6">Customer / User</th>
              <th class="py-3.5 px-6">Plan</th>
              <th class="py-3.5 px-6">Status</th>
              <th class="py-3.5 px-6">Customer ID</th>
              <th class="py-3.5 px-6">Renews / Ends</th>
              <th class="py-3.5 px-6">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {subscriptions.length === 0 ? (
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-500">No active Lemon Squeezy subscriptions recorded yet.</td>
              </tr>
            ) : (
              subscriptions.map((s: any) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-6 font-bold text-white">
                    <a href={`/admin/users/${s.user_id}`} class="hover:text-indigo-400">
                      {s.user_email || s.user_id}
                    </a>
                  </td>
                  <td class="py-4 px-6">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-indigo-900/50 text-indigo-300">
                      {s.plan}
                    </span>
                  </td>
                  <td class="py-4 px-6">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                      s.status === 'active' || s.status === 'trialing' ? 'bg-emerald-900/50 text-emerald-300' : 'bg-amber-900/50 text-amber-300'
                    }`}>
                      {s.status}
                    </span>
                  </td>
                  <td class="py-4 px-6 font-mono text-slate-400 text-[11px]">
                    {s.customer_id || '—'}
                  </td>
                  <td class="py-4 px-6 text-slate-300 font-mono text-[11px]">
                    {s.current_period_end ? new Date(s.current_period_end).toLocaleDateString() : '—'}
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-mono text-[11px]">
                    {new Date(s.created_at).toLocaleDateString()}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
