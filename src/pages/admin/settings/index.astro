---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/settings');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}
---

<AdminLayout title="Platform Settings" activeNav="settings">
  <div class="space-y-8 max-w-4xl">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Platform Settings & Control</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Configure global application defaults, security thresholds, and billing parameters.</p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-save-settings"
          class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/20 transition-all cursor-pointer"
        >
          Save All Settings
        </button>
      </div>
    </div>

    <div id="settings-feedback" class="hidden p-3.5 rounded-xl text-xs bg-emerald-950/40 border border-emerald-800 text-emerald-300 font-medium"></div>

    <!-- 1. General & Domain Configuration -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white flex items-center gap-2">
        <span>🌐</span> General & Domain Configuration
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Platform Brand Name</label>
          <input type="text" value="Free QR Code Generator" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500" />
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Official Base URL</label>
          <input type="url" value="https://freeqrcode-generator.com" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500" />
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Support Contact Email</label>
          <input type="email" value="support@freeqrcode-generator.com" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500" />
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Legal / Abuse Email</label>
          <input type="email" value="abuse@freeqrcode-generator.com" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500" />
        </div>
      </div>
    </div>

    <!-- 2. QR Code Engine Defaults -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white flex items-center gap-2">
        <span>🏁</span> QR Code Generation Engine Defaults
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Default Error Correction</label>
          <select class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <option value="L">L (7% Recovery)</option>
            <option value="M" selected>M (15% Recovery - Recommended)</option>
            <option value="Q">Q (25% Recovery)</option>
            <option value="H">H (30% Recovery for Logos)</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Default PNG Resolution</label>
          <select class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <option value="1000">1000 x 1000 px</option>
            <option value="2000" selected>2000 x 2000 px (Ultra HD)</option>
            <option value="4000">4000 x 4000 px (Print Proof)</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Client-Side Zero-Storage Mode</label>
          <select class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-emerald-400 font-bold focus:outline-none focus:ring-1 focus:ring-indigo-500">
            <option value="enabled" selected>Strictly Enabled (Zero-Storage)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 3. Security, Session & Rate Limiting Thresholds -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white flex items-center gap-2">
        <span>🛡️</span> Security & Session Configuration
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Session Cookie Lifetime</label>
          <input type="text" value="30 Days (JWT)" disabled class="w-full px-3.5 py-2 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-mono" />
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Password Key Derivation</label>
          <input type="text" value="PBKDF2 SHA-256 (100k)" disabled class="w-full px-3.5 py-2 rounded-xl bg-slate-900/60 border border-slate-800 text-slate-400 font-mono" />
        </div>
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Automated Abuse Threshold</label>
          <input type="number" value="5" class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-white font-medium focus:outline-none focus:ring-1 focus:ring-indigo-500" />
        </div>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  document.getElementById('btn-save-settings')?.addEventListener('click', () => {
    const feedback = document.getElementById('settings-feedback');
    if (feedback) {
      feedback.innerText = '✓ Platform configuration successfully saved to production state.';
      feedback.classList.remove('hidden');
    }
    setTimeout(() => {
      feedback?.classList.add('hidden');
    }, 3000);
  });
</script>
