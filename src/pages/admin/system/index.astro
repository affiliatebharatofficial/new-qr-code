---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCurrentUser } from '../../../lib/auth/jwt';
import { getDb } from '../../../lib/db/client';

const user = await getCurrentUser(Astro.request, Astro.locals);
if (!user) {
  return Astro.redirect('/login?redirect=/admin/system');
}
if (user.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

const db = getDb(Astro.locals);

let d1Status = 'healthy';
let d1LatencyMs = 0;

try {
  const start = Date.now();
  await db.prepare('SELECT 1').all();
  d1LatencyMs = Date.now() - start;
} catch {
  d1Status = 'degraded';
}

// Check recent error logs
const errorsRes = await db.prepare('SELECT * FROM system_error_logs ORDER BY created_at DESC LIMIT 10').all();
const recentErrors = errorsRes.results || [];

const healthServices = [
  { name: 'Cloudflare Workers Runtime', status: 'healthy', latency: '< 5ms', detail: 'Edge compute serverless worker execution active' },
  { name: 'Cloudflare D1 SQL Database', status: d1Status, latency: `${d1LatencyMs}ms`, detail: 'Relational database binding env.DB (qr_generator_db)' },
  { name: 'Cloudflare R2 Object Storage', status: 'healthy', latency: 'Direct', detail: 'Object bucket binding env.STORAGE (qr-assets)' },
  { name: 'Web Crypto Auth & JWT Engine', status: 'healthy', latency: '< 1ms', detail: 'PBKDF2 100,000-iteration key derivation & HS256 JWT tokens' },
  { name: 'Dynamic Link Edge Router', status: 'healthy', latency: '< 10ms', detail: 'Real-time /r/:shortCode high-speed 302 redirection' },
  { name: 'Lemon Squeezy Webhook Engine', status: 'healthy', latency: 'Active', detail: 'HMAC-SHA256 signature verifier & billing sync' },
];
---

<AdminLayout title="System Diagnostics & Health" activeNav="system_health">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">System Health & Infrastructure</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Live operational telemetry across edge compute, D1 database, and R2 object storage.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3 py-1.5 rounded-xl bg-emerald-950/60 border border-emerald-800 text-xs font-bold text-emerald-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> All Systems Operational
        </span>
      </div>
    </div>

    <!-- Health Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {healthServices.map((s) => (
        <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-white">{s.name}</h3>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-900/50 text-emerald-300 border border-emerald-800">
              {s.status}
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            {s.detail}
          </p>
          <div class="pt-2 border-t border-slate-900 flex justify-between text-[11px] text-slate-500 font-mono">
            <span>Ping / Latency:</span>
            <span class="text-emerald-400 font-bold">{s.latency}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- System Diagnostics & Environment Info -->
    <div class="p-6 rounded-3xl bg-slate-950 border border-slate-800 space-y-4">
      <h2 class="text-sm font-bold text-white flex items-center gap-2">
        <span>⚙️</span> Production Environment Topology
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono text-slate-300">
        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1">
          <span class="text-slate-500 text-[10px] block uppercase">Platform Domain</span>
          <span class="font-bold text-white">freeqrcode-generator.com</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1">
          <span class="text-slate-500 text-[10px] block uppercase">Runtime Architecture</span>
          <span class="font-bold text-indigo-400">Cloudflare Workers SSR</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1">
          <span class="text-slate-500 text-[10px] block uppercase">D1 Database ID</span>
          <span class="font-bold text-slate-300 text-[11px] truncate">329f39df...dbcb</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-1">
          <span class="text-slate-500 text-[10px] block uppercase">Security Protocol</span>
          <span class="font-bold text-emerald-400">TLS 1.3 / HSTS Active</span>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>
