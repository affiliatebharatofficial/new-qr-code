---
import BaseLayout from '../layouts/BaseLayout.astro';
import Generator from '../components/qr/Generator.astro';
import { QR_TYPE_METADATA } from '../lib/qr/types';

const qrTypes = Object.values(QR_TYPE_METADATA);

const faqs = [
  {
    q: 'Is this QR Code Generator really 100% free?',
    a: 'Yes — every feature is free forever. No account, no free trial, no watermark, and no download limits. Custom colors, dot styles, logo uploads, and high-resolution PNG and vector SVG downloads are all included at no cost.',
  },
  {
    q: 'Do I need to create an account to download my QR code?',
    a: 'No. Generate, customize, and download your QR code instantly — no email, no password, and no sign-up of any kind.',
  },
  {
    q: 'Can I use the QR codes for commercial purposes?',
    a: 'Absolutely. Use them on business cards, packaging, restaurant menus, advertisements, or products — for personal or commercial use, with no attribution required.',
  },
  {
    q: 'Will my QR code expire or stop working?',
    a: 'Never. Static QR codes encode your data directly into the pattern, so they work offline and last forever with no subscription needed to keep them active.',
  },
  {
    q: 'Do generated static QR codes expire?',
    a: 'Static QR codes (URLs, Wi-Fi, vCard, SMS, Email, UPI) encode data directly into the pixel pattern. They never expire and function offline indefinitely without external dependencies.',
  },
  {
    q: 'How does client-side QR generation protect my privacy?',
    a: 'Your QR code is rendered directly in your web browser using HTML5 Canvas and vector SVG generation. Sensitive inputs like Wi-Fi passwords, contact cards, or payment details are never sent to external servers.',
  },
  {
    q: 'What is the difference between Static and Dynamic QR codes?',
    a: 'Static QR codes contain hardcoded data and cannot be altered once printed. Dynamic QR codes route through a short redirection URL, enabling you to update destination links at any time and inspect scan telemetry.',
  },
  {
    q: 'Can I add my custom brand logo to the QR code?',
    a: 'Yes. Upload your PNG, JPG, WebP, or SVG logo. The generator centers the logo, clears interfering background dots, and automatically boosts error correction to preserve scan reliability.',
  },
  {
    q: 'Will my QR code have a watermark?',
    a: 'No. Every download is clean — no watermark, no branding, no attribution. Your QR code is 100% yours.',
  },
  {
    q: 'What is the recommended minimum print size for a QR code?',
    a: 'For close-range handheld materials (like business cards and dining menus), print at a minimum of 20 × 20 mm (0.8 × 0.8 inches). For posters, billboards, or table tents scanned from a distance, maintain a 10:1 distance-to-size ratio (e.g. 10 cm wide for a 1 meter scan distance).',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const trustBadges = [
  '100% free forever',
  'No sign-up needed',
  'No watermarks',
  'Private — runs in your browser',
];

const steps = [
  {
    n: '1',
    title: 'Add your content',
    text: 'Pick a QR type — URL, Wi-Fi, vCard, WhatsApp, UPI, and 13 more — then enter your link, text, or details in the optimized form.',
  },
  {
    n: '2',
    title: 'Customize the design',
    text: 'Change colors, dot styles, and corner shapes. Upload your logo — it is placed automatically while error correction is boosted to keep every code scannable.',
  },
  {
    n: '3',
    title: 'Download & share',
    text: 'Export a high-resolution PNG or a vector SVG. Print it, post it, or stick it anywhere — your QR code never expires.',
  },
];
---

<BaseLayout
  title="Free QR Code Generator with Logo — Vector SVG & PNG"
  description="Create free QR codes with your logo in seconds. Custom colors, high-res PNG & SVG downloads. No sign-up, no watermark — free forever."
  jsonLd={faqJsonLd}
>
  <!-- Hero & Generator Workspace (Above the fold) -->
  <div class="relative bg-grid-subtle py-4 sm:py-6 border-b border-slate-200/80 dark:border-slate-800/80">
    <Generator
      initialType="url"
      headline="Free QR Code Generator"
      subheadline="Design custom QR codes with your logo, brand colors, and frames in seconds. Download high-resolution PNG or print-ready vector SVG — free forever, no sign-up required."
    />
    <!-- Trust badges -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-5">
      <div class="flex flex-wrap items-center justify-center gap-2">
        {trustBadges.map((badge) => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-[11px] font-bold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {badge}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- How it works -->
  <section class="py-12 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto mb-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Create a QR Code in 3 Steps
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          From blank page to print-ready QR code in under a minute.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {steps.map((step) => (
          <div class="relative p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-sm font-extrabold shadow-sm">
              {step.n}
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">{step.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QR Types Section -->
  <section class="py-12 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto mb-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          One Generator, 18 QR Code Types
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Make QR codes for websites, Wi-Fi networks, digital business cards, WhatsApp chats, UPI payments, app downloads, events, locations, and more — each with its own optimized input form.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {qrTypes.map((type) => (
          <a
            href={`/${type.slug}`}
            class="group p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500 dark:hover:border-indigo-400 transition-colors"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
                {type.name}
              </span>
              <span class="text-[10px] font-mono text-slate-400 uppercase">{type.id}</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-snug">
              {type.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why free / SEO content section -->
  <section class="py-12 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight text-center mb-6">
        A Free QR Code Maker That Doesn't Gatekeep
      </h2>
      <div class="space-y-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        <p>
          Most "free" QR code generators show you a paywall the moment you try to add a logo, change a color, or download in high resolution. This one doesn't. Every feature — custom colors, dot styles, eye shapes, logo upload, transparent backgrounds, and high-resolution PNG and vector SVG downloads — is free, with no account and no watermarks.
        </p>
        <p>
          Everything runs 100% in your browser. Your Wi-Fi passwords, contact details, and payment info never leave your device, and the QR codes you create are yours to use anywhere — business cards, menus, packaging, posters, or product labels — for personal or commercial use, forever.
        </p>
      </div>
    </div>
  </section>

  <!-- Sizing & Prepress Calculators Section -->
  <section class="py-12 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto mb-8 text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 mb-2">
          <span>📐</span> Prepress &amp; Optical Tools
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Free QR Sizing &amp; Prepress Calculators
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Ensure reliable scannability before you print. Calculate physical dimensions, 300 DPI pixel grids, and viewing distances.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <!-- Tool 1: Size Calculator -->
        <a
          href="/qr-code-size-calculator"
          class="group p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500 shadow-sm transition-all flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">
              📏
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              QR Code Size Calculator &rarr;
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Calculate the recommended physical width and height for any scan distance using the practical 10:1 optical model, QR version density, and 4-module quiet zones.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1 text-[10px] font-semibold text-slate-400">
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">10:1 Ratio Model</span>
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">Module Thickness</span>
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">Multi-DPI Math</span>
            </div>
          </div>
          <div class="text-xs font-bold text-indigo-600 dark:text-indigo-400 flex items-center gap-1">
            <span>Open Size Calculator</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- Tool 2: Print Size Calculator -->
        <a
          href="/qr-code-print-size-calculator"
          class="group p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-purple-500 shadow-sm transition-all flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-2xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg">
              🖨️
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
              QR Code Print Size &amp; DPI Calculator &rarr;
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Commercial prepress calculator. Convert millimeters to exact raster pixels at 300 DPI, check print material presets, and inspect pre-flight checklists.
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1 text-[10px] font-semibold text-slate-400">
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">300 DPI Converter</span>
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">Print Presets</span>
              <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">Vector SVG Prepress</span>
            </div>
          </div>
          <div class="text-xs font-bold text-purple-600 dark:text-purple-400 flex items-center gap-1">
            <span>Open Print Calculator</span>
            <span>&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Technical Features Section -->
  <section id="features" class="py-12 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto mb-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Why Use Our Free QR Code Generator?
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Everything you need to make professional QR codes — without the paywall.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-700 dark:text-emerald-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Free Forever, No Catch</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            No accounts, no trials, no watermarks, no download limits. The features other tools put behind a paywall — logos, colors, vector SVG — are free here.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-950/60 flex items-center justify-center text-indigo-700 dark:text-indigo-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Private by Design</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Your QR codes are generated entirely in your browser. Wi-Fi passwords, contacts, and payment details are never uploaded to any server.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 shadow-card space-y-2">
          <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/60 flex items-center justify-center text-purple-700 dark:text-purple-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Print-Ready Quality</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Download crisp vector SVGs for professional printing or high-resolution PNGs for the web. Built-in error correction keeps codes scannable even with a logo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Static vs Dynamic Comparison -->
  <section class="py-12 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto mb-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Static vs. Dynamic QR Codes — What's the Difference?
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Not sure which one you need? Here's the quick version.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-xs">
          <thead class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 text-slate-500 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3 px-4">Capability</th>
              <th class="py-3 px-4 text-slate-900 dark:text-white">Static QR</th>
              <th class="py-3 px-4 text-indigo-600 dark:text-indigo-400">Dynamic QR</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
            <tr>
              <td class="py-3 px-4 font-semibold">Destination Editability</td>
              <td class="py-3 px-4 text-slate-400">Fixed at generation</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-semibold">Editable anytime</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold">Scan Telemetry &amp; Geo Metrics</td>
              <td class="py-3 px-4 text-slate-400">None (Privacy-safe)</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-semibold">Country, device, count</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold">Server Dependency</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-semibold">Zero (Functions offline)</td>
              <td class="py-3 px-4 text-slate-500">Edge Redirect Worker</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold">Logo &amp; Style Customization</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-semibold">Supported</td>
              <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400 font-semibold">Supported</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-12 bg-white dark:bg-slate-900 transition-colors">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto mb-8 text-center">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Free QR Code Generator FAQs
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Answers to the most common questions about our free QR code maker.
        </p>
      </div>

      <div class="space-y-2.5">
        {faqs.map((faq) => (
          <details class="group bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800 p-4 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 dark:text-white text-xs sm:text-sm">
              <span>{faq.q}</span>
              <span class="ml-3 text-slate-400 group-open:rotate-180 transition-transform duration-150">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-2.5 text-xs text-slate-500 leading-relaxed">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
