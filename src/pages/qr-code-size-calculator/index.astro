---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QRSizeCalculator from '../../components/calculator/QRSizeCalculator.astro';
import { SCAN_DISTANCE_REFERENCE_TABLE } from '../../lib/calculator/size';
import { extractLocaleFromPath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n/config';
import { getSizeCalculatorPageData } from '../../lib/i18n/content/calculatorPages';

const currentPath = Astro.url.pathname;
const { locale } = extractLocaleFromPath(currentPath);
const sizeData = getSizeCalculatorPageData(locale);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://freeqrcode-generator.com/' },
    { '@type': 'ListItem', position: 2, name: sizeData.h1, item: 'https://freeqrcode-generator.com/qr-code-size-calculator' },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sizeData.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={sizeData.title}
  description={sizeData.description}
  locale={locale}
  jsonLd={[breadcrumbs, faqJsonLd]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
    
    <!-- Top Header -->
    <div class="text-center space-y-3 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
        <span>📏</span> Optical Sizing Tool
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        {sizeData.h1}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        {sizeData.subheadline}
      </p>
    </div>

    <!-- Size Calculator Widget -->
    <QRSizeCalculator locale={locale} />

    <!-- Scan Distance Reference Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-4">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📊</span> {sizeData.tableTitle}
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Quick-reference benchmarks calculated using practical 10:1 distance ratio across common print scenarios.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-sans">
          <thead class="bg-slate-50 dark:bg-slate-950 text-slate-400 font-bold uppercase">
            <tr>
              <th class="py-2.5 px-3">{sizeData.tableHeaders[0]}</th>
              <th class="py-2.5 px-3">{sizeData.tableHeaders[1]}</th>
              <th class="py-2.5 px-3">{sizeData.tableHeaders[2]}</th>
              <th class="py-2.5 px-3">{sizeData.tableHeaders[3]}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {SCAN_DISTANCE_REFERENCE_TABLE.map((row) => (
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                <td class="py-2.5 px-3 font-semibold text-slate-900 dark:text-white">{row.distanceMeters} m ({row.distanceFeet} ft)</td>
                <td class="py-2.5 px-3 text-slate-500 font-mono">{row.minSizeCm} × {row.minSizeCm} cm</td>
                <td class="py-2.5 px-3 text-indigo-600 dark:text-indigo-400 font-bold font-mono">{row.recommendedSizeCm} × {row.recommendedSizeCm} cm</td>
                <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">{row.useCase}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Educational Technical Content -->
    <article class="prose dark:prose-invert max-w-none space-y-8 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-200 dark:border-slate-800 pt-10">
      
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
          {sizeData.overviewTitle}
        </h2>
        {sizeData.overviewParagraphs.map((p) => (
          <p>{p}</p>
        ))}
      </section>

    </article>

    <!-- Structured FAQ Section -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {sizeData.faqsTitle}
        </h2>
      </div>

      <div class="divide-y divide-slate-100 dark:divide-slate-800 space-y-4">
        {sizeData.faqs.map((faq) => (
          <div class="pt-4 space-y-1.5">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white flex items-start gap-2">
              <span class="text-indigo-600 dark:text-indigo-400 font-bold">Q:</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-5">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Tools & Navigation Links -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div class="flex flex-wrap items-center gap-3">
        <span class="font-bold text-slate-900 dark:text-white">Related Tools:</span>
        <a href="/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Code Generator</a>
        <span>•</span>
        <a href="/qr-code-print-size-calculator" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Code Print Size Calculator</a>
        <span>•</span>
        <a href="/guides" class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold">QR Guides</a>
      </div>

      <div>
        <a href="/" class="px-5 py-2.5 rounded-xl font-bold bg-indigo-600 text-white hover:bg-indigo-500 transition-colors shadow-sm">
          Create Custom QR Code &rarr;
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
